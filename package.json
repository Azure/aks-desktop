{
  "name": "aks-desktop-monorepo",
  "version": "0.10.0",
  "description": "AKS desktop - Headlamp Plugin Monorepo",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "postinstall": "npm run headlamp:patch-installed && npm run install:all",
    "build": "tsx ./build/build-host-platform.ts",
    "build:linux": "npm run build:linux:x64",
    "build:linux:x64": "tsx ./build/package-target.ts --platform=linux --arch=x64",
    "build:linux:arm64": "tsx ./build/package-target.ts --platform=linux --arch=arm64",
    "build:mac": "npm run build:mac:x64",
    "build:mac:x64": "tsx ./build/package-target.ts --platform=darwin --arch=x64",
    "build:mac:arm64": "tsx ./build/package-target.ts --platform=darwin --arch=arm64",
    "build:win": "npm run build:win:x64 && npm run build:win:arm64",
    "build:win:x64": "tsx ./build/package-target.ts --platform=win32 --arch=x64",
    "build:win:arm64": "tsx ./build/package-target.ts --platform=win32 --arch=arm64",
    "build:win-ci": "npm run build:win:x64",
    "ci:windows": "node build/windows-ci.cjs",
    "build:unpacked": "npm run headlamp:install && npm run headlamp:assemble && cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json npm --prefix node_modules/@headlamp-k8s/headlamp-source run build:app:unpacked",
    "build:unpacked:linux": "npm run build:unpacked",
    "build:unpacked:mac": "npm run build:unpacked",
    "build:unpacked:win": "npm run build:unpacked",
    "build:container": "npm run headlamp:assemble && cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json npm --prefix node_modules/@headlamp-k8s/headlamp-source run build:container",
    "test:build": "node --test build/windows-ci.test.cjs && npm --prefix packages/headlamp-source run test:helpers && tsx --test build/build-target.test.ts build/az-cli-config.test.ts build/azure-cli-config.test.ts build/azure-cli-verification.test.ts build/generate-frontend-environment.test.ts build/package-target.test.ts build/product-manifest-verification.test.ts build/start-development.test.ts test/integration/*.test.ts",
    "test:headlamp-package": "npm --prefix packages/headlamp-source run test:package && tsx --test test/integration/headlamp-package.test.ts",
    "test:headlamp-patches": "npm run headlamp:patches -- --check && npm run test:headlamp-package",
    "test:i18n": "node --test Localize/translation-manager.test.mjs",
    "test:post-build": "tsx ./build/verify-bundled-tools.ts",
    "test:distribution": "npm run test:post-build && npm run headlamp:smoke --",
    "plugin:setup": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run bundle:plugins",
    "plugin:install": "cd plugins/aks-desktop && npm install",
    "plugin:build": "cd plugins/aks-desktop && npm run build",
    "plugin:start": "cd plugins/aks-desktop && npm start",
    "plugin:test": "cd plugins/aks-desktop && npm test",
    "plugin:lint": "cd plugins/aks-desktop && npm run lint",
    "plugin:test:all": "cd plugins/aks-desktop && npm run test:all",
    "plugin:format": "cd plugins/aks-desktop && npm run format",
    "plugin:package": "cd plugins/aks-desktop && npm run package",
    "plugin-catalog:install": "cd plugins/plugin-catalog && npm install",
    "ai-assistant:install": "cd plugins/ai-assistant && npm install",
    "ai-assistant:build": "cd plugins/ai-assistant && npm run build",
    "ai-assistant:start": "cd plugins/ai-assistant && npm start",
    "ai-assistant:test": "cd plugins/ai-assistant && npm test",
    "ai-assistant:lint": "cd plugins/ai-assistant && npm run lint",
    "ai-assistant:format": "cd plugins/ai-assistant && npm run format",
    "headlamp:manifest": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run manifest:generate",
    "headlamp:frontend-env": "tsx ./build/generate-frontend-environment.ts",
    "headlamp:patches": "npm --prefix packages/headlamp-source run patches:compose --",
    "headlamp:patch-installed": "node --experimental-strip-types packages/headlamp-source/src/bin/compose-patches.ts --apply node_modules/@headlamp-k8s/headlamp-source",
    "headlamp:prepare": "node --experimental-strip-types packages/headlamp-source/src/bin/update-source.ts --prepare --root .",
    "headlamp:assemble": "npm run headlamp:tools && npm run headlamp:translations && npm run plugin:setup && npm run headlamp:manifest && npm run headlamp:frontend-env",
    "headlamp:doctor": "npm run test:headlamp-package && npm --prefix node_modules/@headlamp-k8s/headlamp-source run manifest:check",
    "headlamp:source": "npm --prefix packages/headlamp-source run source:update --",
    "headlamp:smoke": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run smoke:app --",
    "headlamp:tools": "tsx ./build/setup-external-tools.ts",
    "headlamp:translations": "node Localize/translation-manager.mjs distribute-headlamp",
    "headlamp:install": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run install:all",
    "headlamp:build": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run build",
    "install:all": "npm run headlamp:install && npm run plugin:install && npm run ai-assistant:install && npm run plugin-catalog:install",
    "build:all": "npm run headlamp:build && npm run plugin:build && npm run ai-assistant:build",
    "predev": "npm run headlamp:install && npm run headlamp:assemble",
    "dev": "tsx ./build/start-development.ts",
    "dev:services": "cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json concurrently --kill-others --names \"PLUGIN,AI-ASSISTANT,BACKEND,FRONTEND,APP\" -c \"cyan,blue,green,yellow,magenta\" \"npm run plugin:start\" \"npm run ai-assistant:start\" \"npm --prefix node_modules/@headlamp-k8s/headlamp-source run start:backend\" \"npm --prefix node_modules/@headlamp-k8s/headlamp-source run start:frontend\" \"npm --prefix node_modules/@headlamp-k8s/headlamp-source run start:app\"",
    "prepare": "husky",
    "knip": "knip",
    "i18n:collect": "node Localize/translation-manager.mjs collect",
    "i18n:distribute": "node Localize/translation-manager.mjs distribute"
  },
