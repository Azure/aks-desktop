{
  "name": "azure-aks",
  "version": "0.2.0",
  "description": "Azure authentication, AKS managed namespaces, and application deployment features for AKS Desktop",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "npm run bin:build && headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "storybook": "headlamp-plugin storybook",
    "storybook-build": "headlamp-plugin storybook-build",
    "test": "vitest run -c vitest.config.ts",
    "prettier": "prettier --write .",
    "i18n": "headlamp-plugin i18n",
    "bin:build": "node src-bin/download-keytar.mjs && esbuild src-bin/azure-api.ts --bundle --minify --outfile=out/azure-api-bundle.js --platform=node --external:keytar --loader:.node=empty --define:import.meta.url=importMetaUrl --banner:js=\"const importMetaUrl=require('url').pathToFileURL(__filename).href;\"",
    "test:bin": "node --test src-bin/download-keytar.test.mjs",
    "test:unit": "vitest run -c vitest.config.ts --project unit",
    "test:a11y": "vitest run -c vitest.config.ts --project a11y"
  },
  "keywords": [
    "headlamp",
    "kubernetes",
    "kubernetes-ui",
    "kubernetes-debugging",
    "plugins"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ],
    "plugins": [
      "no-barrel-files"
    ],
    "rules": {
      "no-barrel-files/no-barrel-files": "error"
    }
  },
  "overrides": {
    "typescript": "5.6.2",
    "react": "^18.3.1",
    "react-redux": "^9.1.0"
  },
  "devDependencies": {
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "@kinvolk/headlamp-plugin": "^0.13.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@vitest/coverage-istanbul": "^3.2.4",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.52.4",
    "@rollup/rollup-darwin-x64": "^4.52.4",
    "@rollup/rollup-linux-arm64": "^4.50.1",
    "@rollup/rollup-linux-arm64-musl": "^4.52.4",
    "@rollup/rollup-linux-x64": "^4.50.1",
    "@rollup/rollup-linux-x64-musl": "^4.52.3",
    "@rollup/rollup-win32-arm64": "^4.50.1",
    "@rollup/rollup-win32-x64": "^4.50.1",
    "husky": "^9.0.0"
  },
  "dependencies": {
    "@azure/arm-containerservice": "^25.2.0",
    "@azure/arm-subscriptions": "^5.1.0",
    "@azure/identity": "^4.13.1",
    "@azure/identity-cache-persistence": "^1.3.0",
    "keytar": "^7.9.0",
    "yaml": "^2.8.3",
    "@azure/arm-authorization": "^9.0.0",
    "@azure/arm-features": "^3.1.0",
    "@azure/arm-msi": "^2.2.0",
    "@azure/arm-resourcegraph": "^4.2.1",
    "@azure/arm-resources": "^7.0.0",
    "recharts": "^3.1.2"
  },
  "headlamp": {
    "extraDist": {
      "azure-api.js": "src-bin/azure-api-launcher.cjs",
      "lib/azure-api-bundle.js": "out/azure-api-bundle.js",
      "node_modules/keytar": "src-bin/keytar",
      "bin/arm64/dpapi.node": "node_modules/@azure/msal-node-extensions/bin/arm64/dpapi.node",
      "bin/ia32/dpapi.node": "node_modules/@azure/msal-node-extensions/bin/ia32/dpapi.node",
      "bin/x64/dpapi.node": "node_modules/@azure/msal-node-extensions/bin/x64/dpapi.node"
    },
    "i18n": [
      "en",
      "de",
      "es",
      "fr",
      "it",
      "ja",
      "id",
      "ko",
      "pt-BR",
      "ru",
      "zh-Hans",
      "zh-Hant",
      "cs",
      "nl",
      "hu",
      "pt-PT",
      "pl",
      "sv",
      "tr"
    ]
  }
}
