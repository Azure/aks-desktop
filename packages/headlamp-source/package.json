{
  "name": "@headlamp-k8s/headlamp-source",
  "version": "0.0.0-main.d4c87a8f",
  "description": "Headlamp source assembly and npm build entry points",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubernetes-sigs/headlamp.git",
    "commit": "d4c87a8fa3cc109b3ba992ca12e8eda45f5c77f0"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.0.0"
  },
  "files": [
    "source",
    "src"
  ],
  "dependencies": {
    "cross-spawn": "7.0.6",
    "tsx": "4.23.1"
  },
  "scripts": {
    "prepare": "node --experimental-strip-types src/bin/update-source.ts --prepare",
    "install:all": "npm --prefix source run install:all",
    "build": "npm --prefix source run build",
    "build:backend": "npm --prefix source run backend:build",
    "build:frontend": "npm --prefix source run frontend:build",
    "build:app": "npm --prefix source run app:package",
    "build:app:linux": "npm --prefix source run app:package:linux",
    "build:app:mac": "npm --prefix source run app:package:mac",
    "build:app:win": "npm --prefix source run app:package:win",
    "build:app:unpacked": "npm --prefix source run app:build",
    "build:container": "docker buildx build --pull --platform=local --build-arg HEADLAMP_SOURCE_COMMIT=d4c87a8fa3cc109b3ba992ca12e8eda45f5c77f0 --build-arg HEADLAMP_BUILD_MANIFEST -t ghcr.io/headlamp-k8s/headlamp:0.0.0-main.d4c87a8f -f source/Dockerfile source",
    "build:plugins-container": "docker buildx build --pull --platform=local -t ghcr.io/headlamp-k8s/plugins:0.0.0-main.d4c87a8f -f source/Dockerfile.plugins source",
    "start": "npm --prefix source run start:with-app",
    "start:backend": "npm --prefix source run start:backend",
    "start:frontend": "npm --prefix source run start:frontend",
    "start:app": "npm --prefix source run app:start:client",
    "bundle:plugins": "tsx src/bin/bundle-plugins.ts",
    "manifest:generate": "tsx src/bin/generate-product-manifest.ts",
    "manifest:check": "tsx src/bin/generate-product-manifest.ts --check",
    "patches:compose": "tsx src/bin/compose-patches.ts",
    "smoke:app": "tsx src/bin/smoke-app.ts",
    "source:prepare": "tsx src/bin/update-source.ts --prepare",
    "source:update": "tsx src/bin/update-source.ts",
    "test:helpers": "npm run tsc:helpers && tsx --test src/lib/*.test.ts test/*.test.ts",
    "test:package": "npm run tsc:helpers && tsx --test test/package-contract.test.ts",
    "tsc:helpers": "tsc --noEmit -p tsconfig.json",
    "test": "npm --prefix source test",
    "lint": "npm --prefix source run lint",
    "tsc": "npm --prefix source run frontend:tsc && npm --prefix source run app:tsc",
    "verify:images": "npm --prefix source run image:verify-image-digests"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  },
  "headlampSource": {
    "revision": "d4c87a8fa3cc109b3ba992ca12e8eda45f5c77f0",
    "goVersion": "1.26.8"
  }
}
