       const defaultMenu = getDefaultAppMenu();
+      loadFullMenu = false;
+      setMenu(mainWindow, defaultMenu);
       const currentMenu = JSON.parse(JSON.stringify(defaultMenu));
       mainWindow?.webContents.send('currentMenu', currentMenu);
     });
