 1 file changed, 3 insertions(+)

diff --git a/app/electron/preload.ts b/app/electron/preload.ts
index 420e5c109..d8f56be75 100644
--- a/app/electron/preload.ts
+++ b/app/electron/preload.ts
@@ -35,6 +35,9 @@ contextBridge.exposeInMainWorld('desktopApi', {
   oidcLogout: (cluster: string) => ipcRenderer.invoke('oidc-logout', cluster),
   isDevelopment: Boolean(process.env.ELECTRON_DEV),
   getDevelopmentPluginsEnabled: () => ipcRenderer.invoke('get-development-plugins'),
+  // Compatibility marker used by AI Assistant to identify AKS Desktop.
+  registerAKSCluster: () => undefined,
+
   send: (channel: string, data: unknown) => {
     // allowed channels
     const validChannels = [
