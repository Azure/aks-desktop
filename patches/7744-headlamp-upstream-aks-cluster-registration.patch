+import { describe, expect, it, vi } from 'vitest';
+import { getClusterRegistrationArgValues } from './clusterRegistration';
+
+describe('cluster registration capability', () => {
+  it('injects a capability-bound registration function only for the trusted plugin', async () => {
+    const invoke = vi.fn().mockResolvedValue({ success: true, message: 'registered' });
+    const [names, values] = getClusterRegistrationArgValues(['azure'], invoke, 'a'.repeat(64));
+
+    expect(names).toEqual(['registerCluster']);
+    await expect(
+      (values[0] as Function)('azure', {
+        subscriptionId: 'subscription',
+        resourceGroup: 'resource-group',
+        clusterName: 'cluster',
+        isAzureRBACEnabled: false,
+      })
+    ).resolves.toEqual({ success: true, message: 'registered' });
+    expect(invoke).toHaveBeenCalledWith(
+      'azure',
+      {
+        subscriptionId: 'subscription',
+        resourceGroup: 'resource-group',
+        clusterName: 'cluster',
+        isAzureRBACEnabled: false,
+      },
+      'a'.repeat(64)
+    );
+    await expect((values[0] as Function)('gke', {})).resolves.toEqual({
+      success: false,
+      message: "Cluster registration provider 'gke' is not authorized for this plugin.",
+    });
+    expect(invoke).toHaveBeenCalledTimes(1);
+    expect(getClusterRegistrationArgValues([], invoke, 'a'.repeat(64))).toEqual([[], []]);
+  });
+});
