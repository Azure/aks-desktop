-    : path.join(process.resourcesPath, 'assets', trayIconFilename);
+  const iconPath = resolveTrayIconPath(options);
 
-  const trayIcon = nativeImage.createFromPath(iconPath);
+  let trayIcon = nativeImage.createFromPath(iconPath);
   if (trayIcon.isEmpty()) {
     console.error(
       `Failed to load tray icon from path "${iconPath}". System tray will not be created.`
@@ -127,6 +152,9 @@ export function createHeadlampTray(options: HeadlampTrayOptions): boolean {
