+/**
+ * Resolves an already-authorized command through an optional app-owned callback.
+ * The product verifies its executable; core confines the result to app-owned resources.
+ *
+ * @param command - Authorized command name, not a renderer-supplied executable path.
+ * @param manifest - Trusted application build manifest selecting the optional callback module.
+ * @param resourcesDirectory - App-owned resource root.
+ * @returns The canonical executable, or undefined to preserve existing command lookup.
+ * @throws When resolution fails, returns an invalid value, or escapes app-owned resources.
+ */
+export function resolveCommandExecutable(
+  command: string,
+  manifest: Record<string, unknown>,
+  resourcesDirectory: string
+): string | undefined {
+  const loaded = loadCommandEnvironmentModule(manifest, resourcesDirectory);
+  if (!loaded || loaded.callbacks.resolveExecutable === undefined) return undefined;
+  const { resolveExecutable } = loaded.callbacks;
+  if (typeof resolveExecutable !== 'function') {
+    throw new Error('commandEnvironment resolveExecutable must be a function');
+  }
+  const result: unknown = resolveExecutable(command, manifest, loaded.root);
+  if (result === undefined) return undefined;
+  if (typeof result !== 'string' || result.includes('\0') || !path.isAbsolute(result)) {
+    throw new Error('resolveExecutable must return an absolute resource path synchronously');
+  }
+  const canonical = fs.realpathSync(result);
+  if (
+    !isPathWithin(loaded.root, canonical) ||
+    isPathWithin(path.join(loaded.root, '.plugins'), canonical) ||
+    !fs.statSync(canonical).isFile()
+  ) {
+    throw new Error('resolveExecutable must select an app-owned resource');
+  }
+  return canonical;
+}
