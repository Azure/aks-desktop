From 946c24c7b0541c1ddabb1691e58a9c07ee87d99d Mon Sep 17 00:00:00 2001
From: Ziling Zhou <106626435+Ziling-Zhou@users.noreply.github.com>
Date: Wed, 18 Nov 2026 16:47:16 -0800
Subject: [PATCH] backend: kubeconfig: Accept null contexts

client-go writes an empty context list as null, for example after a
tool removes the last context. The loader rejected such a file as
invalid, so a watched change could not drop the removed context, and
LoadContextsFromMultipleFiles stopped at that file, so no file listed
in KUBECONFIG loaded. Treat null contexts as none; a missing or
non-list contexts field is still rejected.

#8354 accepts the same null collections in the app's cluster
registration.

Signed-off-by: Ziling Zhou <106626435+Ziling-Zhou@users.noreply.github.com>
Copilot-Session: f09a445e-4bb7-45a3-bb9f-d6945f074f28
---
 backend/pkg/kubeconfig/kubeconfig.go      |  9 ++++++++-
 backend/pkg/kubeconfig/kubeconfig_test.go | 13 +++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/backend/pkg/kubeconfig/kubeconfig.go b/backend/pkg/kubeconfig/kubeconfig.go
index 53ed8ef9..46273ae9 100644
--- a/backend/pkg/kubeconfig/kubeconfig.go
+++ b/backend/pkg/kubeconfig/kubeconfig.go
@@ -927,7 +927,14 @@ func UnmarshalKubeconfig(data []byte) (map[string]interface{}, error) {
 
 // GetContextsFromKubeconfig gets the contexts from the kubeconfig.
 func GetContextsFromKubeconfig(kubeconfig map[string]interface{}) ([]interface{}, error) {
-	rawContexts, ok := kubeconfig["contexts"].([]interface{})
+	value, present := kubeconfig["contexts"]
+	// client-go writes an empty context list as null, for example after the last context is
+	// deleted or pruned; that file has no contexts rather than invalid ones.
+	if present && value == nil {
+		return []interface{}{}, nil
+	}
+
+	rawContexts, ok := value.([]interface{})
 	if !ok {
 		return nil, DataError{Field: "contexts", Reason: "invalid or missing contexts in kubeconfig"}
 	}
diff --git a/backend/pkg/kubeconfig/kubeconfig_test.go b/backend/pkg/kubeconfig/kubeconfig_test.go
index bb610af2..6815d7a2 100644
--- a/backend/pkg/kubeconfig/kubeconfig_test.go
+++ b/backend/pkg/kubeconfig/kubeconfig_test.go
@@ -1224,6 +1224,19 @@ func TestResolveKubeconfigPathsNoopForEmptyOrigin(t *testing.T) {
 	assert.Equal(t, "pki/token", cfg.AuthInfos["u"].TokenFile)
 }
 
+func TestLoadContextsFromFileAcceptsNullCollections(t *testing.T) {
+	// client-go writes this after the last context, cluster and user are removed.
+	path := filepath.Join(t.TempDir(), "config")
+	require.NoError(t, os.WriteFile(path, []byte(
+		"apiVersion: v1\nclusters: null\ncontexts: null\ncurrent-context: \"\"\nkind: Config\nusers: null\n",
+	), 0o600))
+
+	contexts, contextErrors, err := kubeconfig.LoadContextsFromFile(path, kubeconfig.KubeConfig)
+	require.NoError(t, err)
+	assert.Empty(t, contexts)
+	assert.Empty(t, contextErrors)
+}
+
 func TestLoadContextsFromFileResolvesRelativePKIPaths(t *testing.T) {
 	t.Parallel()
 
