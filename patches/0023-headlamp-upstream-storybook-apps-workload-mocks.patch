Date: Mon, 24 Aug 2026 12:25:19 +0200
Subject: [PATCH 1/2] e2e-tests: workloads.spec: Verify apps workload lists

Cover each apps workload list page so missing Kubernetes API responses are
caught by a browser-level regression test.
---
 e2e-tests/tests/workloads.spec.ts | 133 ++++++++++++++++++++++++++++++
 1 file changed, 133 insertions(+)
 create mode 100644 e2e-tests/tests/workloads.spec.ts

diff --git a/e2e-tests/tests/workloads.spec.ts b/e2e-tests/tests/workloads.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fec4539adbd3dd060b3f7ea7ceafdd2e8703a6ed
--- /dev/null
+++ b/e2e-tests/tests/workloads.spec.ts
@@ -0,0 +1,133 @@
+/*
+ * Copyright 2026 The Kubernetes Authors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ * http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+import { expect, test } from '@playwright/test';
+import { HeadlampPage } from './headlampPage';
+
+const containerName = 'workload-container';
+const containerImage = 'registry.k8s.io/pause:3.10';
+const labels = { app: 'headlamp-e2e' };
+const podTemplate = {
+  metadata: { labels },
+  spec: {
+    containers: [{ name: containerName, image: containerImage }],
+  },
+};
+
+const appsWorkloads = [
+  {
+    resource: 'daemonsets',
+    kind: 'DaemonSet',
+    name: 'logging-agent',
+    title: /DaemonSets/,
+    spec: {
+      selector: { matchLabels: labels },
+      template: {
+        ...podTemplate,
+        spec: { ...podTemplate.spec, nodeSelector: { 'kubernetes.io/os': 'linux' } },
+      },
+    },
+    status: { currentNumberScheduled: 3, desiredNumberScheduled: 3, numberReady: 2 },
+    expectedText: 'kubernetes.io/os: linux',
+  },
+  {
+    resource: 'deployments',
+    kind: 'Deployment',
+    name: 'web-server',
+    title: /Deployments/,
+    spec: { replicas: 3, selector: { matchLabels: labels }, template: podTemplate },
+    status: {
+      replicas: 3,
+      availableReplicas: 2,
+      readyReplicas: 2,
+      conditions: [{ type: 'Available', status: 'True', message: 'Deployment is available' }],
+    },
+    expectedText: 'Available',
+  },
+  {
+    resource: 'replicasets',
+    kind: 'ReplicaSet',
+    name: 'web-server-replica',
+    title: /ReplicaSets/,
+    spec: { replicas: 3, selector: { matchLabels: labels }, template: podTemplate },
+    status: { replicas: 3, readyReplicas: 2, availableReplicas: 2, observedGeneration: 1 },
+    expectedText: containerName,
+  },
+  {
+    resource: 'statefulsets',
+    kind: 'StatefulSet',
+    name: 'database',
+    title: /StatefulSets/,
+    spec: {
+      replicas: 3,
+      serviceName: 'database',
+      selector: { matchLabels: labels },
+      template: podTemplate,
+    },
+    status: { replicas: 3, readyReplicas: 2, currentReplicas: 3, observedGeneration: 1 },
+    expectedText: '2/3',
+  },
+];
+
+for (const workload of appsWorkloads) {
+  test(`loads the ${workload.kind} list page`, async ({ page }) => {
+    let requestSeen = false;
+    const collectionUrl = new RegExp(
+      `/clusters/test/apis/apps/v1/(?:namespaces/[^/]+/)?${workload.resource}(?:\\?.*)?$`
+    );
+    await page.route(collectionUrl, async route => {
+      requestSeen = true;
+      const namespaceMatch = new URL(route.request().url()).pathname.match(
+        /\/namespaces\/([^/]+)\//
+      );
+      const namespace = namespaceMatch ? decodeURIComponent(namespaceMatch[1]) : 'default';
+
+      await route.fulfill({
+        json: {
+          apiVersion: 'apps/v1',
+          kind: `${workload.kind}List`,
+          metadata: { resourceVersion: '1' },
+          items: [
+            {
+              apiVersion: 'apps/v1',
+              kind: workload.kind,
+              metadata: {
+                name: workload.name,
+                namespace,
+                resourceVersion: '1',
+                creationTimestamp: '2026-01-01T00:00:00Z',
+                uid: `${workload.resource}-uid`,
+              },
+              spec: workload.spec,
+              status: workload.status,
+            },
+          ],
+        },
+      });
+    });
+
+    const headlampPage = new HeadlampPage(page);
+    await headlampPage.navigateToCluster('test', process.env.HEADLAMP_TEST_TOKEN);
+    await headlampPage.navigateTopage(`/c/test/${workload.resource}`, workload.title);
+
+    await expect.poll(() => requestSeen).toBe(true);
+    const workloadRow = page
+      .getByRole('row')
+      .filter({ has: page.getByRole('link', { name: workload.name, exact: true }) });
+    await expect(workloadRow).toBeVisible();
+    await expect(workloadRow.getByText(workload.expectedText, { exact: true })).toBeVisible();
+  });
+}
-- 
