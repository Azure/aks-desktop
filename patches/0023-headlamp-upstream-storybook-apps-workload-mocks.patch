diff --git a/frontend/src/test/storybookBaseMocks.test.ts b/frontend/src/test/storybookBaseMocks.test.ts
index f18486a2f3664d0e4e5d906be60cade6b227c633..e9055b8de5f3a2c23a57665bf560e8accd4d44cd 100644
