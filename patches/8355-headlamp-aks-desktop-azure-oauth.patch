+ * limitations under the License.
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+  type AzureOAuthBridge,
+  captureAzureOAuthBridge,
+  getPluginAzureOAuthArgValues,
+} from './azureOAuth';
+import type { PluginCommandCapability } from './commandCapabilities';
+import type { PluginInfo } from './pluginsSlice';
+
+const CAPABILITY = 'a'.repeat(64);
+const SESSION_ID = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
+const plugin = {
+  name: '@example/plugin',
+  folderName: 'example-plugin',
+  source: 'shipped',
+  type: 'shipped',
+} as PluginInfo;
+const granted: PluginCommandCapability = {
+  bundleName: 'example-plugin',
+  packageName: '@example/plugin',
+  source: 'shipped',
+  capability: CAPABILITY,
+  clusterRegistrationProviders: [],
+  azureOAuth: true,
+};
+
+function bridge(): AzureOAuthBridge {
+  return {
+    start: vi.fn().mockResolvedValue({ success: true }),
+    status: vi.fn().mockResolvedValue({ success: true, pending: true }),
+    getToken: vi.fn().mockResolvedValue({
+      success: true,
+      accessToken: 'token',
+      expiresOnTimestamp: 123,
+    }),
+    cancel: vi.fn().mockResolvedValue({ success: true }),
+    logout: vi.fn().mockResolvedValue({ success: true }),
+  };
+}
+
+describe('private Azure OAuth facade', () => {
+  beforeEach(() => {
+    vi.spyOn(crypto, 'randomUUID').mockReturnValue(SESSION_ID);
+  });
+
+  it('injects a facade only for the exact granted plugin identity', async () => {
+    const raw = bridge();
+    const [names, values] = getPluginAzureOAuthArgValues([granted], plugin, raw);
+
+    expect(names).toEqual(['pluginAzureOAuth']);
+    const facade = values[0] as Record<string, (...args: any[]) => Promise<unknown>>;
+    await facade.startAzureLogin('AzureCloud', 'scope');
+    await facade.getAzureToken('scope', 'tenant');
+    expect(raw.start).toHaveBeenCalledWith(CAPABILITY, SESSION_ID, 'AzureCloud', 'scope');
+    expect(raw.getToken).toHaveBeenCalledWith(CAPABILITY, SESSION_ID, 'scope', 'tenant');
+  });
+
+  it.each([
+    ['another package', [granted], { ...plugin, name: '@other/plugin' }],
+    ['another bundle', [granted], { ...plugin, folderName: 'other' }],
+    ['an ungranted capability', [{ ...granted, azureOAuth: undefined }], plugin],
+    ['a malformed capability', [{ ...granted, capability: 'invalid' }], plugin],
+  ])('withholds the facade from %s', (_name, capabilities, candidate) => {
+    expect(
+      getPluginAzureOAuthArgValues(
+        capabilities as PluginCommandCapability[],
+        candidate as PluginInfo,
+        bridge()
+      )
+    ).toEqual([[], []]);
+  });
+
+  it('captures bridge functions before plugins can mutate the global object', async () => {
+    const raw = bridge();
+    const original = raw.start;
+    const captured = captureAzureOAuthBridge(raw)!;
+    raw.start = vi.fn();
+
+    await captured.start(CAPABILITY, SESSION_ID, 'AzureCloud', 'scope');
+
+    expect(original).toHaveBeenCalledWith(CAPABILITY, SESSION_ID, 'AzureCloud', 'scope');
+    expect(raw.start).not.toHaveBeenCalled();
+  });
+});
