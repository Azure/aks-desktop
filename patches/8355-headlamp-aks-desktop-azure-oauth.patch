+
+import { EventEmitter } from 'node:events';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const { handlers } = vi.hoisted(() => ({
+  handlers: new Map<string, (...args: unknown[]) => unknown>(),
+}));
+
+vi.mock('electron', () => ({
+  ipcMain: {
+    handle: (channel: string, handler: (...args: unknown[]) => unknown) => {
+      handlers.set(channel, handler);
+    },
+    removeHandler: (channel: string) => handlers.delete(channel),
+  },
+}));
+
+import {
+  AZURE_OAUTH_CANCEL,
+  AZURE_OAUTH_LOGOUT,
+  AZURE_OAUTH_START,
+  AZURE_OAUTH_STATUS,
+  AZURE_OAUTH_TOKEN,
+  setupAzureOAuth,
+} from './azureOAuth';
+
+const START_URL = 'http://localhost:4466/';
+const CAPABILITY = 'a'.repeat(64);
+const OTHER_CAPABILITY = 'b'.repeat(64);
+const SESSION_ID = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
+const ARM_SCOPE = 'https://management.core.windows.net//.default';
+const GRAPH_SCOPE = 'https://graph.microsoft.com/.default';
+const CHINA_ARM_SCOPE = 'https://management.core.chinacloudapi.cn//.default';
+const CONFIG = {
+  clientId: 'public-client',
+  clouds: [
+    {
+      name: 'AzureCloud',
+      authority: 'https://login.microsoftonline.com',
+      scopes: [ARM_SCOPE, GRAPH_SCOPE],
+    },
+    {
+      name: 'AzureChinaCloud',
+      authority: 'https://login.chinacloudapi.cn',
+      scopes: [CHINA_ARM_SCOPE],
+    },
+  ],
+};
+
+class FakeWebContents extends EventEmitter {
+  mainFrame = { url: START_URL };
+}
+
+function fakeWindow() {
+  const webContents = new FakeWebContents();
+  return {
+    webContents,
+    isDestroyed: () => false,
+  };
+}
+
+type FakeWindow = ReturnType<typeof fakeWindow>;
+
+function event(window: FakeWindow) {
+  return { sender: window.webContents, senderFrame: window.webContents.mainFrame };
+}
+
+function invoke(channel: string, sender: unknown, payload?: unknown) {
+  const handler = handlers.get(channel);
+  if (!handler) throw new Error(`No handler for ${channel}`);
+  return handler(sender, payload) as Promise<any>;
+}
+
+function response(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+function jwt(claims: Record<string, unknown>) {
+  return `header.${Buffer.from(JSON.stringify(claims)).toString('base64url')}.signature`;
+}
+
+const fetchMock = vi.fn();
+let cleanup: (() => void) | undefined;
+
+function setup(window: FakeWindow) {
+  cleanup = setupAzureOAuth({
+    mainWindow: window as any,
+    trustedStartUrl: START_URL,
+    config: CONFIG,
+    authorizeAzureOAuth: (_event, capability) => capability === CAPABILITY,
+    isAzureOAuthCapabilityLive: capability => capability === CAPABILITY,
+  });
+}
+
+describe('Azure OAuth main-process capability', () => {
+  beforeEach(() => {
+    handlers.clear();
+    vi.stubGlobal('fetch', fetchMock);
+    fetchMock.mockReset();
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    cleanup?.();
+    cleanup = undefined;
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+  });
+
+  it('rejects an ungranted capability before making a request', async () => {
+    const window = fakeWindow();
+    setup(window);
+
+    await expect(
+      invoke(AZURE_OAUTH_START, event(window), {
+        capability: OTHER_CAPABILITY,
+        sessionId: SESSION_ID,
+        cloud: 'AzureCloud',
+        scope: ARM_SCOPE,
+      })
+    ).resolves.toEqual({ success: false, error: 'Unauthorized request' });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('polls in the main process and decodes UTF-8 account claims', async () => {
+    const window = fakeWindow();
+    setup(window);
+    fetchMock
+      .mockResolvedValueOnce(
+        response({
+          device_code: 'device-code',
+          user_code: 'CODE',
+          verification_uri: 'https://microsoft.com/devicelogin',
+          message: 'Enter CODE',
+          expires_in: 900,
+          interval: 1,
+        })
+      )
+      .mockResolvedValueOnce(
+        response({
+          access_token: 'arm-token',
+          refresh_token: 'refresh-token',
+          id_token: jwt({ tid: 'home-tenant', name: 'José Müller' }),
+          expires_in: 3600,
+        })
+      );
+
+    await expect(
+      invoke(AZURE_OAUTH_START, event(window), {
+        capability: CAPABILITY,
+        sessionId: SESSION_ID,
+        cloud: 'AzureCloud',
+        scope: ARM_SCOPE,
+      })
+    ).resolves.toMatchObject({
+      success: true,
+      pending: true,
+      prompt: { userCode: 'CODE' },
+    });
+
+    await vi.advanceTimersByTimeAsync(1_000);
+
+    expect(
+      invoke(AZURE_OAUTH_STATUS, event(window), {
+        capability: CAPABILITY,
+        sessionId: SESSION_ID,
+      })
+    ).toEqual({
+      success: true,
+      pending: false,
+      account: { username: 'José Müller', tenantId: 'home-tenant' },
+    });
+  });
+
+  it('uses the selected sovereign authority and scope', async () => {
+    const window = fakeWindow();
+    setup(window);
+    fetchMock.mockResolvedValueOnce(
+      response({
+        device_code: 'device-code',
+        user_code: 'CODE',
+        verification_uri: 'https://microsoft.com/devicelogin',
+        expires_in: 900,
+        interval: 1,
+      })
+    );
+
+    await invoke(AZURE_OAUTH_START, event(window), {
+      capability: CAPABILITY,
+      sessionId: SESSION_ID,
+      cloud: 'AzureChinaCloud',
+      scope: CHINA_ARM_SCOPE,
+    });
+
+    expect(fetchMock.mock.calls[0][0]).toBe(
+      'https://login.chinacloudapi.cn/common/oauth2/v2.0/devicecode'
+    );
+    expect(String(fetchMock.mock.calls[0][1].body)).toContain(
+      `scope=${encodeURIComponent(CHINA_ARM_SCOPE)}`
+    );
+  });
+
+  it('shares a refresh and rotates the main-process refresh credential', async () => {
+    const window = fakeWindow();
+    setup(window);
+    fetchMock
+      .mockResolvedValueOnce(
+        response({
+          device_code: 'device-code',
+          user_code: 'CODE',
+          verification_uri: 'https://microsoft.com/devicelogin',
+          expires_in: 900,
+          interval: 1,
+        })
+      )
+      .mockResolvedValueOnce(
+        response({
+          access_token: 'arm-token',
+          refresh_token: 'refresh-token',
+          id_token: jwt({ tid: 'home-tenant' }),
+          expires_in: 3600,
+        })
+      )
+      .mockResolvedValueOnce(
+        response({
+          access_token: 'graph-token',
+          refresh_token: 'rotated-refresh-token',
+          expires_in: 3600,
+        })
+      );
+    await invoke(AZURE_OAUTH_START, event(window), {
+      capability: CAPABILITY,
+      sessionId: SESSION_ID,
+      cloud: 'AzureCloud',
+      scope: ARM_SCOPE,
+    });
+    await vi.advanceTimersByTimeAsync(1_000);
+
+    const request = {
+      capability: CAPABILITY,
+      sessionId: SESSION_ID,
+      scope: GRAPH_SCOPE,
+      tenantId: 'guest-tenant',
+    };
+    const [first, second] = await Promise.all([
+      invoke(AZURE_OAUTH_TOKEN, event(window), request),
+      invoke(AZURE_OAUTH_TOKEN, event(window), request),
+    ]);
+
+    expect(first).toMatchObject({ success: true, accessToken: 'graph-token' });
+    expect(second).toEqual(first);
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+    expect(fetchMock.mock.calls[2][0]).toBe(
+      'https://login.microsoftonline.com/guest-tenant/oauth2/v2.0/token'
+    );
+    expect(String(fetchMock.mock.calls[2][1].body)).toContain('refresh_token=refresh-token');
+  });
+
+  it.each([['guest-tenant'], [undefined]])(
+    'keeps a resource interaction error scoped to the %s request',
+    async tenantId => {
+      const window = fakeWindow();
+      setup(window);
+      fetchMock
+        .mockResolvedValueOnce(
+          response({
+            device_code: 'device-code',
+            user_code: 'CODE',
+            verification_uri: 'https://microsoft.com/devicelogin',
+            expires_in: 900,
+            interval: 1,
+          })
+        )
+        .mockResolvedValueOnce(
+          response({
+            access_token: 'arm-token',
+            refresh_token: 'refresh-token',
+            id_token: jwt({ tid: 'home-tenant' }),
+            expires_in: 3600,
+          })
+        )
+        .mockResolvedValueOnce(
+          response(
+            {
+              error: 'interaction_required',
+              error_description: 'Resource requires interaction',
+            },
+            400
+          )
+        );
+      await invoke(AZURE_OAUTH_START, event(window), {
+        capability: CAPABILITY,
+        sessionId: SESSION_ID,
+        cloud: 'AzureCloud',
+        scope: ARM_SCOPE,
+      });
+      await vi.advanceTimersByTimeAsync(1_000);
+
+      const failed = await invoke(AZURE_OAUTH_TOKEN, event(window), {
+        capability: CAPABILITY,
+        sessionId: SESSION_ID,
+        scope: GRAPH_SCOPE,
+        tenantId,
+      });
+      expect(failed).toMatchObject({ success: false });
+      expect(failed).not.toHaveProperty('sessionExpired');
+      expect(
+        invoke(AZURE_OAUTH_STATUS, event(window), {
+          capability: CAPABILITY,
+          sessionId: SESSION_ID,
+        })
+      ).toMatchObject({
+        success: true,
+        pending: false,
+      });
+    }
+  );
+
+  it('invalidates every tenant after token-wide refresh expiry', async () => {
+    const window = fakeWindow();
+    setup(window);
+    fetchMock
+      .mockResolvedValueOnce(
+        response({
+          device_code: 'device-code',
+          user_code: 'CODE',
+          verification_uri: 'https://microsoft.com/devicelogin',
+          expires_in: 900,
+          interval: 1,
+        })
+      )
+      .mockResolvedValueOnce(
+        response({
+          access_token: 'arm-token',
+          refresh_token: 'refresh-token',
+          id_token: jwt({ tid: 'home-tenant' }),
+          expires_in: 3600,
+        })
+      )
+      .mockResolvedValueOnce(
+        response(
+          {
+            error: 'invalid_grant',
+            error_description: 'AADSTS700082: The refresh token has expired.',
+          },
+          400
+        )
+      );
+    await invoke(AZURE_OAUTH_START, event(window), {
+      capability: CAPABILITY,
+      sessionId: SESSION_ID,
+      cloud: 'AzureCloud',
+      scope: ARM_SCOPE,
+    });
+    await vi.advanceTimersByTimeAsync(1_000);
+
+    await expect(
+      invoke(AZURE_OAUTH_TOKEN, event(window), {
+        capability: CAPABILITY,
+        sessionId: SESSION_ID,
+        scope: GRAPH_SCOPE,
+        tenantId: 'guest-tenant',
+      })
+    ).resolves.toMatchObject({ success: false, sessionExpired: true });
+  });
+
+  it.each([AZURE_OAUTH_CANCEL, AZURE_OAUTH_LOGOUT])(
+    '%s clears the capability session',
+    async channel => {
+      const window = fakeWindow();
+      setup(window);
+      fetchMock.mockResolvedValueOnce(
+        response({
+          device_code: 'device-code',
+          user_code: 'CODE',
+          verification_uri: 'https://microsoft.com/devicelogin',
+          expires_in: 900,
+          interval: 1,
+        })
+      );
+      await invoke(AZURE_OAUTH_START, event(window), {
+        capability: CAPABILITY,
+        sessionId: SESSION_ID,
+        cloud: 'AzureCloud',
+        scope: ARM_SCOPE,
+      });
+
+      expect(
+        invoke(channel, event(window), {
+          capability: CAPABILITY,
+          sessionId: SESSION_ID,
+        })
+      ).toEqual({ success: true });
+      expect(
+        invoke(AZURE_OAUTH_STATUS, event(window), {
+          capability: CAPABILITY,
+          sessionId: SESSION_ID,
+        })
+      ).toEqual({
+        success: false,
+        error: 'Azure login is required',
+      });
+    }
+  );
+
+  it('does not let stale cleanup clear a newer session', async () => {
+    const window = fakeWindow();
+    setup(window);
+    fetchMock
+      .mockResolvedValueOnce(
+        response({
+          device_code: 'old-device-code',
+          user_code: 'OLD',
+          verification_uri: 'https://microsoft.com/devicelogin',
+          expires_in: 900,
+          interval: 1,
+        })
+      )
+      .mockResolvedValueOnce(
+        response({
+          device_code: 'new-device-code',
+          user_code: 'NEW',
+          verification_uri: 'https://microsoft.com/devicelogin',
+          expires_in: 900,
+          interval: 1,
+        })
+      );
+    const newerSessionId = 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
+    await invoke(AZURE_OAUTH_START, event(window), {
+      capability: CAPABILITY,
+      sessionId: SESSION_ID,
+      cloud: 'AzureCloud',
+      scope: ARM_SCOPE,
+    });
+    await invoke(AZURE_OAUTH_START, event(window), {
+      capability: CAPABILITY,
+      sessionId: newerSessionId,
+      cloud: 'AzureCloud',
+      scope: ARM_SCOPE,
+    });
+
+    expect(
+      invoke(AZURE_OAUTH_CANCEL, event(window), {
+        capability: CAPABILITY,
+        sessionId: SESSION_ID,
+      })
+    ).toEqual({ success: false, error: 'Azure login is required' });
+    expect(
+      invoke(AZURE_OAUTH_STATUS, event(window), {
+        capability: CAPABILITY,
+        sessionId: newerSessionId,
+      })
+    ).toEqual({ success: true, pending: true });
+  });
+});
