+import type { BrowserWindow, IpcMainInvokeEvent } from 'electron';
+import { ipcMain } from 'electron';
+import type { BuildManifest } from '../scripts/build-manifest';
+import { isTrustedDocumentUrl } from './secureStorage';
+
+export const AZURE_OAUTH_START = 'azure-oauth-start';
+export const AZURE_OAUTH_STATUS = 'azure-oauth-status';
+export const AZURE_OAUTH_TOKEN = 'azure-oauth-token';
+export const AZURE_OAUTH_CANCEL = 'azure-oauth-cancel';
+export const AZURE_OAUTH_LOGOUT = 'azure-oauth-logout';
+
+const REQUEST_TIMEOUT_MS = 30_000;
+const REFRESH_MARGIN_MS = 5 * 60 * 1000;
+const TENANT_PATTERN = /^[A-Za-z0-9][A-Za-z0-9.-]{0,255}$/;
+const SESSION_ID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const UNAUTHORIZED = 'Unauthorized request';
+const NOT_AVAILABLE = 'Azure authentication is not available in this build.';
+const CANCELLED = 'Azure sign-in was cancelled';
+
+type AzureOAuthConfig = NonNullable<BuildManifest['azureOAuth']>;
+type AzureCloud = AzureOAuthConfig['clouds'][number];
+
+export interface AzureOAuthResult {
+  success: boolean;
+  error?: string;
+  code?: string;
+  sessionExpired?: boolean;
+  pending?: boolean;
+  account?: { username?: string; tenantId?: string };
+  prompt?: { userCode: string; verificationUri: string; message: string };
+  accessToken?: string;
+  expiresOnTimestamp?: number;
+}
+
+export interface AzureOAuthOptions {
+  mainWindow: BrowserWindow;
+  trustedStartUrl: string;
+  config?: AzureOAuthConfig;
+  authorizeAzureOAuth?: (event: IpcMainInvokeEvent, capability: string) => boolean;
+  isAzureOAuthCapabilityLive?: (capability: string) => boolean;
+}
+
+interface OAuthToken {
+  token: string;
+  expiresOnTimestamp: number;
+}
+
+interface Session {
+  id: string;
+  generation: number;
+  cloud: AzureCloud;
+  pending: boolean;
+  error?: OAuthFailure;
+  refreshToken?: string;
+  homeTenantId?: string;
+  username?: string;
+  controller: AbortController;
+  tokens: Map<string, Promise<OAuthToken>>;
+  refreshTail: Promise<void>;
+}
+
+interface TokenResponse {
+  access_token?: unknown;
+  expires_in?: unknown;
+  refresh_token?: unknown;
+  id_token?: unknown;
+}
+
+let activeCleanup: (() => void) | null = null;
+
+class OAuthFailure extends Error {
+  constructor(message: string, readonly code?: string, readonly sessionExpired = false) {
+    super(message);
+  }
+}
+
+function failureResult(error: unknown): AzureOAuthResult {
+  const failure =
+    error instanceof OAuthFailure
+      ? error
+      : new OAuthFailure(error instanceof Error ? error.message : 'Azure authentication failed');
+  return {
+    success: false,
+    error: failure.message,
+    ...(failure.code && { code: failure.code }),
+    ...(failure.sessionExpired && { sessionExpired: true }),
+  };
+}
+
+function parseOAuthFailure(body: unknown): OAuthFailure {
+  const details =
+    body && typeof body === 'object'
+      ? (body as { error?: unknown; error_description?: unknown })
+      : undefined;
+  return new OAuthFailure(
+    typeof details?.error_description === 'string'
+      ? details.error_description
+      : 'Azure authentication failed',
+    typeof details?.error === 'string' ? details.error : undefined
+  );
+}
+
+async function readJson(response: Response): Promise<unknown> {
+  const text = await response.text();
+  if (!text) return undefined;
+  try {
+    return JSON.parse(text);
+  } catch {
+    return undefined;
+  }
+}
+
+async function postForm(
+  url: string,
+  values: Record<string, string>,
+  signal: AbortSignal,
+  timeout = REQUEST_TIMEOUT_MS
+): Promise<{ response: Response; body: unknown }> {
+  const controller = new AbortController();
+  const abort = () => controller.abort(signal.reason);
+  signal.addEventListener('abort', abort, { once: true });
+  const timer = setTimeout(
+    () => controller.abort(new OAuthFailure('Azure request timed out')),
+    timeout
+  );
+  try {
+    const response = await fetch(url, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/x-www-form-urlencoded',
+        'x-ms-useragent': 'HEADLAMP-DESKTOP',
+      },
+      body: new URLSearchParams(values),
+      signal: controller.signal,
+    });
+    return { response, body: await readJson(response) };
+  } catch (error) {
+    if (signal.aborted) throw new OAuthFailure(CANCELLED);
+    if (controller.signal.aborted) throw new OAuthFailure('Azure request timed out');
+    throw error;
+  } finally {
+    clearTimeout(timer);
+    signal.removeEventListener('abort', abort);
+  }
+}
+
+function decodeClaims(token: unknown): Record<string, unknown> {
+  if (typeof token !== 'string') return {};
+  try {
+    const payload = token.split('.')[1];
+    if (!payload) return {};
+    return JSON.parse(Buffer.from(payload, 'base64url').toString('utf8'));
+  } catch {
+    return {};
+  }
+}
+
+function validateToken(body: unknown): { token: OAuthToken; response: TokenResponse } {
+  const response = (body ?? {}) as TokenResponse;
+  const expiresIn = Number(response.expires_in);
+  if (
+    typeof response.access_token !== 'string' ||
+    !response.access_token ||
+    !Number.isFinite(expiresIn) ||
+    expiresIn <= 0
+  ) {
+    throw new OAuthFailure('Invalid Azure authentication response');
+  }
+  return {
+    token: {
+      token: response.access_token,
+      expiresOnTimestamp: Date.now() + expiresIn * 1000,
+    },
+    response,
+  };
+}
+
+function isTokenWideFailure(error: OAuthFailure): boolean {
+  return (
+    error.code === 'invalid_client' || /\bAADSTS(?:50173|70000|70008|700082)\b/i.test(error.message)
+  );
+}
+
+function tokenEndpoint(cloud: AzureCloud, tenant = 'common'): string {
+  return `${cloud.authority}/${encodeURIComponent(tenant)}/oauth2/v2.0/token`;
+}
+
+export function setupAzureOAuth(options: AzureOAuthOptions): () => void {
+  activeCleanup?.();
+  const { mainWindow, trustedStartUrl, config, authorizeAzureOAuth, isAzureOAuthCapabilityLive } =
+    options;
+  const sessions = new Map<string, Session>();
+  const generations = new Map<string, number>();
+  let disposed = false;
+
+  const isTrustedRenderer = () =>
+    !disposed &&
+    !mainWindow.isDestroyed() &&
+    isTrustedDocumentUrl(mainWindow.webContents.mainFrame.url, trustedStartUrl);
+  const isAuthorized = (event: IpcMainInvokeEvent, capability: unknown): capability is string =>
+    typeof capability === 'string' &&
+    event.sender === mainWindow.webContents &&
+    event.senderFrame === mainWindow.webContents.mainFrame &&
+    isTrustedRenderer() &&
+    authorizeAzureOAuth?.(event, capability) === true;
+  const isLive = (capability: string) =>
+    isTrustedRenderer() && isAzureOAuthCapabilityLive?.(capability) === true;
+  const cloudFor = (name: unknown): AzureCloud | undefined =>
+    typeof name === 'string' ? config?.clouds.find(cloud => cloud.name === name) : undefined;
+  const scopeAllowed = (cloud: AzureCloud, scope: unknown): scope is string =>
+    typeof scope === 'string' && cloud.scopes.includes(scope);
+  const validSessionId = (sessionId: unknown): sessionId is string =>
+    typeof sessionId === 'string' && SESSION_ID_PATTERN.test(sessionId);
+
+  const clearSession = (capability: string) => {
+    generations.set(capability, (generations.get(capability) ?? 0) + 1);
+    sessions.get(capability)?.controller.abort();
+    sessions.delete(capability);
+  };
+
+  const current = (capability: string, generation: number) =>
+    isLive(capability) &&
+    generations.get(capability) === generation &&
+    sessions.get(capability)?.generation === generation;
+
+  const poll = async (
+    capability: string,
+    session: Session,
+    deviceCode: string,
+    intervalSeconds: number,
+    expiresInSeconds: number,
+    scope: string
+  ) => {
+    const deadline = Date.now() + expiresInSeconds * 1000;
+    let interval = intervalSeconds;
+    while (current(capability, session.generation)) {
+      const remaining = deadline - Date.now();
+      if (remaining <= 0) throw new OAuthFailure('Azure device login expired', 'expired_token');
+      await new Promise(resolve => setTimeout(resolve, Math.min(interval * 1000, remaining)));
+      if (!current(capability, session.generation)) return;
+      let response: Response;
+      let body: unknown;
+      try {
+        ({ response, body } = await postForm(
+          tokenEndpoint(session.cloud),
+          {
+            client_id: config!.clientId,
+            grant_type: 'urn:ietf:params:oauth:grant-type:device_code',
+            device_code: deviceCode,
+          },
+          session.controller.signal,
+          Math.min(REQUEST_TIMEOUT_MS, Math.max(1, deadline - Date.now()))
+        ));
+      } catch (error) {
+        if (!current(capability, session.generation)) return;
+        if (Date.now() >= deadline) throw new OAuthFailure('Azure device login expired');
+        if (error instanceof OAuthFailure && error.message === CANCELLED) return;
+        continue;
+      }
+      if (!response.ok) {
+        const error = parseOAuthFailure(body);
+        if (error.code === 'authorization_pending') continue;
+        if (error.code === 'slow_down') {
+          interval += 5;
+          continue;
+        }
+        if (response.status === 429 || response.status >= 500) continue;
+        throw error;
+      }
+      const { token, response: tokens } = validateToken(body);
+      if (!current(capability, session.generation)) return;
+      if (typeof tokens.refresh_token !== 'string' || !tokens.refresh_token) {
+        throw new OAuthFailure('Azure authentication response did not include a refresh token');
+      }
+      const claims = decodeClaims(tokens.id_token ?? tokens.access_token);
+      session.refreshToken = tokens.refresh_token;
+      session.homeTenantId = typeof claims.tid === 'string' ? claims.tid : undefined;
+      session.username =
+        typeof claims.preferred_username === 'string'
+          ? claims.preferred_username
+          : typeof claims.name === 'string'
+          ? claims.name
+          : undefined;
+      session.tokens.set(`|${scope}`, Promise.resolve(token));
+      session.pending = false;
+      return;
+    }
+  };
+
+  for (const channel of [
+    AZURE_OAUTH_START,
+    AZURE_OAUTH_STATUS,
+    AZURE_OAUTH_TOKEN,
+    AZURE_OAUTH_CANCEL,
+    AZURE_OAUTH_LOGOUT,
+  ]) {
+    ipcMain.removeHandler(channel);
+  }
+
+  ipcMain.handle(AZURE_OAUTH_START, async (event, payload: unknown): Promise<AzureOAuthResult> => {
+    const request = (typeof payload === 'object' && payload !== null ? payload : {}) as {
+      capability?: unknown;
+      sessionId?: unknown;
+      cloud?: unknown;
+      scope?: unknown;
+    };
+    if (!isAuthorized(event, request.capability))
+      return failureResult(new OAuthFailure(UNAUTHORIZED));
+    if (!validSessionId(request.sessionId)) {
+      return failureResult(new OAuthFailure('Invalid Azure authentication session'));
+    }
+    if (!config) return failureResult(new OAuthFailure(NOT_AVAILABLE));
+    const cloud = cloudFor(request.cloud);
+    if (!cloud || !scopeAllowed(cloud, request.scope)) {
+      return failureResult(new OAuthFailure('Unsupported Azure cloud or token scope'));
+    }
+    clearSession(request.capability);
+    const generation = generations.get(request.capability)!;
+    const session: Session = {
+      id: request.sessionId,
+      generation,
+      cloud,
+      pending: true,
+      controller: new AbortController(),
+      tokens: new Map(),
+      refreshTail: Promise.resolve(),
+    };
+    sessions.set(request.capability, session);
+    try {
+      const { response, body } = await postForm(
+        `${cloud.authority}/common/oauth2/v2.0/devicecode`,
+        {
+          client_id: config.clientId,
+          scope: `${request.scope} openid profile offline_access`,
+        },
+        session.controller.signal
+      );
+      if (!response.ok) throw parseOAuthFailure(body);
+      const device = (body ?? {}) as {
+        device_code?: unknown;
+        user_code?: unknown;
+        verification_uri?: unknown;
+        message?: unknown;
+        expires_in?: unknown;
+        interval?: unknown;
+      };
+      const expiresIn = Number(device.expires_in);
+      const interval = device.interval === undefined ? 5 : Number(device.interval);
+      if (
+        typeof device.device_code !== 'string' ||
+        !device.device_code ||
+        typeof device.user_code !== 'string' ||
+        !device.user_code ||
+        typeof device.verification_uri !== 'string' ||
+        !/^https:\/\//i.test(device.verification_uri) ||
+        !Number.isFinite(expiresIn) ||
+        expiresIn <= 0 ||
+        !Number.isFinite(interval) ||
+        interval <= 0
+      ) {
+        throw new OAuthFailure('Invalid Azure authentication response');
+      }
+      if (!current(request.capability, generation)) throw new OAuthFailure(CANCELLED);
+      void poll(
+        request.capability,
+        session,
+        device.device_code,
+        interval,
+        expiresIn,
+        request.scope
+      ).catch(error => {
+        if (!current(request.capability as string, generation)) return;
+        session.pending = false;
+        session.error =
+          error instanceof OAuthFailure
+            ? error
+            : new OAuthFailure(
+                error instanceof Error ? error.message : 'Azure authentication failed'
+              );
+      });
+      return {
+        success: true,
+        pending: true,
+        prompt: {
+          userCode: device.user_code,
+          verificationUri: device.verification_uri,
+          message:
+            typeof device.message === 'string'
+              ? device.message
+              : `Open ${device.verification_uri} and enter code ${device.user_code}.`,
+        },
+      };
+    } catch (error) {
+      if (current(request.capability, generation)) clearSession(request.capability);
+      return failureResult(error);
+    }
+  });
+
+  ipcMain.handle(AZURE_OAUTH_STATUS, (event, payload: unknown): AzureOAuthResult => {
+    const request = (typeof payload === 'object' && payload !== null ? payload : {}) as {
+      capability?: unknown;
+      sessionId?: unknown;
+    };
+    if (!isAuthorized(event, request.capability))
+      return failureResult(new OAuthFailure(UNAUTHORIZED));
+    const session = sessions.get(request.capability);
+    if (!validSessionId(request.sessionId) || session?.id !== request.sessionId) {
+      return failureResult(new OAuthFailure('Azure login is required'));
+    }
+    if (session.error) return failureResult(session.error);
+    if (session.pending) return { success: true, pending: true };
+    return {
+      success: true,
+      pending: false,
+      account: { username: session.username, tenantId: session.homeTenantId },
+    };
+  });
+
+  ipcMain.handle(AZURE_OAUTH_TOKEN, async (event, payload: unknown): Promise<AzureOAuthResult> => {
+    const request = (typeof payload === 'object' && payload !== null ? payload : {}) as {
+      capability?: unknown;
+      sessionId?: unknown;
+      scope?: unknown;
+      tenantId?: unknown;
+    };
+    if (!isAuthorized(event, request.capability))
+      return failureResult(new OAuthFailure(UNAUTHORIZED));
+    const session = sessions.get(request.capability);
+    if (
+      !validSessionId(request.sessionId) ||
+      session?.id !== request.sessionId ||
+      session.pending ||
+      !session.refreshToken
+    ) {
+      return failureResult(new OAuthFailure('Azure login is required'));
+    }
+    if (
+      !scopeAllowed(session.cloud, request.scope) ||
+      (request.tenantId !== undefined &&
+        (typeof request.tenantId !== 'string' || !TENANT_PATTERN.test(request.tenantId)))
+    ) {
+      return failureResult(new OAuthFailure('Invalid Azure token request'));
+    }
+    const tenantId = request.tenantId as string | undefined;
+    const key = `${tenantId ?? ''}|${request.scope}`;
+    const load = async (): Promise<OAuthToken> => {
+      const cached = session.tokens.get(key);
+      if (cached) {
+        const token = await cached;
+        if (token.expiresOnTimestamp - REFRESH_MARGIN_MS > Date.now()) return token;
+        if (session.tokens.get(key) !== cached) return load();
+      }
+      const pending = (async () => {
+        const previous = session.refreshTail;
+        let releaseRefresh!: () => void;
+        session.refreshTail = new Promise(resolve => {
+          releaseRefresh = resolve;
+        });
+        await previous;
+        try {
+          const credential = session.refreshToken;
+          if (!credential) throw session.error ?? new OAuthFailure('Azure login is required');
+          const { response, body } = await postForm(
+            tokenEndpoint(session.cloud, tenantId ?? session.homeTenantId),
+            {
+              client_id: config!.clientId,
+              grant_type: 'refresh_token',
+              refresh_token: credential,
+              scope: request.scope as string,
+            },
+            session.controller.signal
+          );
+          if (!response.ok) {
+            const error = parseOAuthFailure(body);
+            const homeRequest =
+              !tenantId ||
+              !session.homeTenantId ||
+              tenantId.toLowerCase() === session.homeTenantId.toLowerCase();
+            if (
+              ['invalid_grant', 'invalid_client'].includes(error.code ?? '') &&
+              (homeRequest || isTokenWideFailure(error))
+            ) {
+              session.refreshToken = undefined;
+              session.tokens.clear();
+              session.error = new OAuthFailure(error.message, error.code, true);
+            }
+            throw session.error ?? error;
+          }
+          const validated = validateToken(body);
+          if (
+            credential === session.refreshToken &&
+            typeof validated.response.refresh_token === 'string' &&
+            validated.response.refresh_token
+          ) {
+            session.refreshToken = validated.response.refresh_token;
+          }
+          return validated.token;
+        } finally {
+          releaseRefresh();
+        }
+      })();
+      session.tokens.set(key, pending);
+      pending.catch(() => {
+        if (session.tokens.get(key) === pending) session.tokens.delete(key);
+      });
+      return pending;
+    };
+    try {
+      const token = await load();
+      if (!isLive(request.capability) || sessions.get(request.capability) !== session) {
+        return failureResult(new OAuthFailure(CANCELLED));
+      }
+      return {
+        success: true,
+        accessToken: token.token,
+        expiresOnTimestamp: token.expiresOnTimestamp,
+      };
+    } catch (error) {
+      return failureResult(error);
+    }
+  });
+
+  const clear = (event: IpcMainInvokeEvent, payload: unknown): AzureOAuthResult => {
+    const request = (typeof payload === 'object' && payload !== null ? payload : {}) as {
+      capability?: unknown;
+      sessionId?: unknown;
+    };
+    if (!isAuthorized(event, request.capability))
+      return failureResult(new OAuthFailure(UNAUTHORIZED));
+    const session = sessions.get(request.capability);
+    if (!validSessionId(request.sessionId) || session?.id !== request.sessionId) {
+      return failureResult(new OAuthFailure('Azure login is required'));
+    }
+    clearSession(request.capability);
+    return { success: true };
+  };
+  ipcMain.handle(AZURE_OAUTH_CANCEL, clear);
+  ipcMain.handle(AZURE_OAUTH_LOGOUT, clear);
+
+  const onNavigation = (
+    _event: unknown,
+    _url: string,
+    isInPlace: boolean,
+    isMainFrame: boolean
+  ) => {
+    if (isMainFrame && !isInPlace) {
+      for (const capability of sessions.keys()) clearSession(capability);
+    }
+  };
+  mainWindow.webContents.on('did-start-navigation', onNavigation);
+
+  const cleanup = () => {
+    if (disposed) return;
+    disposed = true;
+    for (const capability of sessions.keys()) clearSession(capability);
+    mainWindow.webContents.removeListener('did-start-navigation', onNavigation);
+    if (activeCleanup === cleanup) {
+      for (const channel of [
+        AZURE_OAUTH_START,
+        AZURE_OAUTH_STATUS,
+        AZURE_OAUTH_TOKEN,
+        AZURE_OAUTH_CANCEL,
+        AZURE_OAUTH_LOGOUT,
+      ]) {
+        ipcMain.removeHandler(channel);
+      }
+      activeCleanup = null;
+    }
+  };
+  activeCleanup = cleanup;
+  return cleanup;
+}
+
+export function cleanupAzureOAuth(): void {
+  activeCleanup?.();
+}
