+
+import type { BrowserWindow, IpcMainInvokeEvent } from 'electron';
+import { randomUUID } from 'node:crypto';
+import { EventEmitter } from 'node:events';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { AzureOAuthResult } from './azureOAuth';
+
+type Handler = (
+  event: IpcMainInvokeEvent,
+  payload: unknown
+) => AzureOAuthResult | Promise<AzureOAuthResult>;
+
+const handlers = vi.hoisted(() => new Map<string, Handler>());
+
+vi.mock('electron', () => ({
+  ipcMain: {
+    handle: (channel: string, handler: Handler) => handlers.set(channel, handler),
+    removeHandler: (channel: string) => handlers.delete(channel),
+  },
+}));
+
+import {
+  AZURE_OAUTH_CANCEL,
+  AZURE_OAUTH_START,
+  AZURE_OAUTH_STATUS,
+  setupAzureOAuth,
+} from './azureOAuth';
+
+let dispose: (() => void) | undefined;
+
+afterEach(() => {
+  dispose?.();
+  dispose = undefined;
+  handlers.clear();
+  vi.restoreAllMocks();
+});
+
+describe.runIf(process.env.AZ_LIVE_TESTS === '1')('Azure OAuth service (live, no sign-in)', () => {
+  it('receives a real device challenge, polls pending authorization, and cancels', async () => {
+    const startUrl = 'http://localhost:4466/';
+    const webContents = Object.assign(new EventEmitter(), { mainFrame: { url: startUrl } });
+    const mainWindow = { webContents, isDestroyed: () => false } as BrowserWindow;
+    const event = { sender: webContents, senderFrame: webContents.mainFrame } as IpcMainInvokeEvent;
+    const capability = randomUUID();
+    const sessionId = randomUUID();
+    const scope = 'https://management.core.windows.net//.default';
+    const realFetch = globalThis.fetch;
+    let pendingResponses = 0;
+    vi.spyOn(globalThis, 'fetch').mockImplementation(async (input, init) => {
+      const response = await realFetch(input, init);
+      if (String(input).endsWith('/oauth2/v2.0/token')) {
+        const body: { error?: unknown } = await response.clone().json();
+        if (body.error === 'authorization_pending') pendingResponses++;
+      }
+      return response;
+    });
+    dispose = setupAzureOAuth({
+      mainWindow,
+      trustedStartUrl: startUrl,
+      config: {
+        clientId: '04b07795-8ddb-461a-bbee-02f9e1bf7b46',
+        clouds: [
+          { name: 'AzureCloud', authority: 'https://login.microsoftonline.com', scopes: [scope] },
+        ],
+      },
+      authorizeAzureOAuth: (_event, value) => value === capability,
+      isAzureOAuthCapabilityLive: value => value === capability,
+    });
+    const invoke = async (channel: string, payload: Record<string, unknown> = {}) => {
+      const handler = handlers.get(channel);
+      if (!handler) throw new Error('Azure OAuth live-test handler is missing');
+      return handler(event, { capability, sessionId, ...payload });
+    };
+
+    // Never print or approve the challenge: this test must not establish a user session.
+    const started = await invoke(AZURE_OAUTH_START, { cloud: 'AzureCloud', scope });
+    expect(started.success).toBe(true);
+    expect(started.pending).toBe(true);
+    expect(Boolean(started.prompt?.userCode)).toBe(true);
+    expect(started.prompt?.verificationUri.startsWith('https://')).toBe(true);
+    await vi.waitFor(() => expect(pendingResponses > 0).toBe(true), { timeout: 45_000 });
+    expect((await invoke(AZURE_OAUTH_STATUS)).pending).toBe(true);
+    expect((await invoke(AZURE_OAUTH_CANCEL)).success).toBe(true);
+    expect((await invoke(AZURE_OAUTH_STATUS)).success).toBe(false);
+  }, 60_000);
+});
