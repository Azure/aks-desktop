+
+import { findPluginCapability, type PluginCommandCapability } from './commandCapabilities';
+import type { PluginInfo } from './pluginsSlice';
+
+export interface AzureOAuthResult {
+  success: boolean;
+  error?: string;
+  code?: string;
+  sessionExpired?: boolean;
+  pending?: boolean;
+  account?: { username?: string; tenantId?: string };
+  prompt?: { userCode: string; verificationUri: string; message: string };
+  accessToken?: string;
+  expiresOnTimestamp?: number;
+}
+
+export interface AzureOAuthBridge {
+  start(
+    capability: string,
+    sessionId: string,
+    cloud: string,
+    scope: string
+  ): Promise<AzureOAuthResult>;
+  status(capability: string, sessionId: string): Promise<AzureOAuthResult>;
+  getToken(
+    capability: string,
+    sessionId: string,
+    scope: string,
+    tenantId?: string
+  ): Promise<AzureOAuthResult>;
+  cancel(capability: string, sessionId: string): Promise<AzureOAuthResult>;
+  logout(capability: string, sessionId: string): Promise<AzureOAuthResult>;
+}
+
+export interface PluginAzureOAuth {
+  startAzureLogin(cloud: string, scope: string): Promise<AzureOAuthResult>;
+  getAzureLoginStatus(): Promise<AzureOAuthResult>;
+  getAzureToken(scope: string, tenantId?: string): Promise<AzureOAuthResult>;
+  cancelAzureLogin(): Promise<AzureOAuthResult>;
+  logoutAzure(): Promise<AzureOAuthResult>;
+}
+
+export function captureAzureOAuthBridge(
+  bridge: Partial<AzureOAuthBridge> | undefined
+): AzureOAuthBridge | undefined {
+  const start = bridge?.start;
+  const status = bridge?.status;
+  const getToken = bridge?.getToken;
+  const cancel = bridge?.cancel;
+  const logout = bridge?.logout;
+  if (
+    typeof start !== 'function' ||
+    typeof status !== 'function' ||
+    typeof getToken !== 'function' ||
+    typeof cancel !== 'function' ||
+    typeof logout !== 'function'
+  ) {
+    return undefined;
+  }
+  return Object.freeze({ start, status, getToken, cancel, logout });
+}
+
+function createPluginAzureOAuth(capability: string, bridge: AzureOAuthBridge): PluginAzureOAuth {
+  const failed = (): AzureOAuthResult => ({
+    success: false,
+    error: 'Azure authentication failed',
+  });
+  let sessionId: string | undefined;
+  return Object.freeze({
+    async startAzureLogin(cloud: string, scope: string) {
+      const requestedSessionId = crypto.randomUUID();
+      sessionId = requestedSessionId;
+      try {
+        const result = await bridge.start(capability, requestedSessionId, cloud, scope);
+        if (!result.success && sessionId === requestedSessionId) sessionId = undefined;
+        return result;
+      } catch {
+        if (sessionId === requestedSessionId) sessionId = undefined;
+        return failed();
+      }
+    },
+    async getAzureLoginStatus() {
+      const requestedSessionId = sessionId;
+      if (!requestedSessionId) return failed();
+      try {
+        return await bridge.status(capability, requestedSessionId);
+      } catch {
+        return failed();
+      }
+    },
+    async getAzureToken(scope: string, tenantId?: string) {
+      const requestedSessionId = sessionId;
+      if (!requestedSessionId) return failed();
+      try {
+        return await bridge.getToken(capability, requestedSessionId, scope, tenantId);
+      } catch {
+        return failed();
+      }
+    },
+    async cancelAzureLogin() {
+      const requestedSessionId = sessionId;
+      if (!requestedSessionId) return { success: true };
+      try {
+        const result = await bridge.cancel(capability, requestedSessionId);
+        if (result.success && sessionId === requestedSessionId) sessionId = undefined;
+        return result;
+      } catch {
+        return failed();
+      }
+    },
+    async logoutAzure() {
+      const requestedSessionId = sessionId;
+      if (!requestedSessionId) return { success: true };
+      try {
+        const result = await bridge.logout(capability, requestedSessionId);
+        if (result.success && sessionId === requestedSessionId) sessionId = undefined;
+        return result;
+      } catch {
+        return failed();
+      }
+    },
+  });
+}
+
+export function getPluginAzureOAuthArgValues(
+  capabilities: PluginCommandCapability[],
+  plugin: PluginInfo,
+  bridge: AzureOAuthBridge | undefined
+): [string[], unknown[]] {
+  const capability = findPluginCapability(capabilities, plugin);
+  if (!bridge || capability?.azureOAuth !== true || !/^[0-9a-f]{64}$/.test(capability.capability)) {
+    return [[], []];
+  }
+  return [['pluginAzureOAuth'], [createPluginAzureOAuth(capability.capability, bridge)]];
+}
