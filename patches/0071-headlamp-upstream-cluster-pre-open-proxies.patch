+  });
+
+  it('does not create a capability without a preload bridge or secret', () => {
+    expect(getClusterProxyArgValues(true, undefined, { startClusterProxy: 731 })).toEqual([[], []]);
+    expect(getClusterProxyArgValues(true, vi.fn(), {})).toEqual([[], []]);
