-import { ClusterRegistrationProvider } from './cluster-registration';
-
-/** The AKS Local plugin's host capability (`aksedge-local`). */
-export const LOCAL_PROVIDER = 'aksedge-local';
-
-type LocalRequest = { action: 'capabilities' };
-
-interface LocalProviderOptions {
-  platform?: NodeJS.Platform;
-  arch?: string;
-}
-
-const isRecord = (value: unknown): value is Record<string, unknown> =>
-  typeof value === 'object' && value !== null && !Array.isArray(value);
-
-export function isLocalRequest(value: unknown): value is LocalRequest {
-  return isRecord(value) && value.action === 'capabilities' && Object.keys(value).length === 1;
-}
-
-/**
- * The AKS Local compatibility handshake (contract version 3). The AKS Desktop CLI merges the
- * cluster's context into the user's kubeconfig and prunes it on delete, so Desktop keeps no
- * credentials, files or registration for local clusters: it only grants the CLI commands.
- */
-export function createLocalClusterRegistrationProvider(
-  options: LocalProviderOptions = {}
-): ClusterRegistrationProvider<LocalRequest> {
-  return {
-    id: LOCAL_PROVIDER,
-    validateOptions: isLocalRequest,
-    async register() {
-      if (
-        (options.platform ?? process.platform) !== 'win32' ||
-        (options.arch ?? process.arch) !== 'x64'
-      ) {
-        return {
-          success: false,
-          message: 'Local clusters require Windows x64.',
-          data: { code: 'unsupported' },
-        };
-      }
-      return {
-        success: true,
-        message: 'Local cluster compatibility contract.',
-        data: { contract: LOCAL_PROVIDER, version: 3, platform: 'win32', arch: 'x64' },
-      };
-    },
-  };
-}
