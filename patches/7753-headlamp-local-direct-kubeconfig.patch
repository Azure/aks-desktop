-/** Reads the target back from the managed file; the file itself identifies the local cluster. */
-export function readRegisteredLocalTarget(contents: string): LocalTarget {
-  const config = parseCredentials(contents);
-  const context = section(config, 'contexts', 'context');
-  const extensions = context.extensions;
-  if (!Array.isArray(extensions)) throw new LocalHandoffError('identity-mismatch');
-  const matches = extensions.filter(value => isRecord(value) && value.name === 'context_info');
-  const metadata: unknown = matches.length === 1 ? matches[0].extension : undefined;
-  if (
-    !isRecord(metadata) ||
-    metadata.distro !== LOCAL_DISTRO ||
-    !isLocalConfiguration(metadata) ||
-    named(config, 'contexts').name !== metadata.name ||
-    config['current-context'] !== metadata.name
-  ) {
-    throw new LocalHandoffError('identity-mismatch');
-  }
-  validateCredentials(config);
-  localServer(section(config, 'clusters', 'cluster').server);
-  return {
-    name: metadata.name,
-    kubernetesVersion: metadata.kubernetesVersion,
-    reference: 'registered',
-    contextName: metadata.name,
-    registered: true,
-  };
-}
