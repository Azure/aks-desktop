-export function normalizeLocalKubeconfig(
-  contents: string,
-  configuration: LocalConfiguration,
-  reference: string
-): { contents: string; target: LocalTarget } {
-  const config = parseCredentials(contents);
-  if (config['current-context'] !== configuration.name) {
-    throw new LocalHandoffError('identity-mismatch');
-  }
-  const clusterName = named(config, 'clusters').name as string;
-  const userName = named(config, 'users').name as string;
-  const originalContext = section(config, 'contexts', 'context');
-  if (
-    named(config, 'contexts').name !== configuration.name ||
-    originalContext.cluster !== clusterName ||
-    originalContext.user !== userName
-  ) {
-    throw new LocalHandoffError('identity-mismatch');
-  }
-  const originalCluster = section(config, 'clusters', 'cluster');
-  const user = validateCredentials(config);
-  const cluster: Record<string, unknown> = { server: localServer(originalCluster.server) };
-  if (originalCluster['insecure-skip-tls-verify'] === true) {
-    // Preserve, but do not strengthen or hide, the existing CLI's demo-only TLS behavior.
-    cluster['insecure-skip-tls-verify'] = true;
-  } else {
-    cluster['certificate-authority-data'] = certificateData(
-      originalCluster['certificate-authority-data']
-    );
-  }
-  const extensions = Array.isArray(originalContext.extensions)
-    ? originalContext.extensions.filter(isRecord)
-    : [];
-  const contextInfo = extensions.filter(value => value.name === 'context_info');
-  const cliContextInfo: unknown = contextInfo.length === 1 ? contextInfo[0].extension : undefined;
-  if (
-    !isRecord(cliContextInfo) ||
-    cliContextInfo.distro !== LOCAL_DISTRO ||
-    cliContextInfo.name !== configuration.name ||
-    cliContextInfo.kubernetesVersion !== configuration.kubernetesVersion
-  ) {
-    throw new LocalHandoffError('identity-mismatch');
-  }
-  const target: LocalTarget = {
-    name: configuration.name,
-    kubernetesVersion: configuration.kubernetesVersion,
-    reference,
-    contextName: configuration.name,
-    registered: reference === 'registered',
-  };
-  const normalized = {
-    apiVersion: 'v1',
-    kind: 'Config',
-    clusters: [{ name: clusterName, cluster }],
-    users: [{ name: userName, user }],
-    contexts: [
-      {
-        name: configuration.name,
-        context: {
-          cluster: clusterName,
-          user: userName,
-          extensions,
-        },
-      },
-    ],
-    'current-context': configuration.name,
-  };
-  return {
-    contents: yaml.stringify(normalized, { lineWidth: 0, defaultStringType: 'QUOTE_DOUBLE' }),
-    target,
-  };
-}
