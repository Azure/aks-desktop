 app/electron/build-manifest.test.ts | 59 ++++++++++++++++++++++++++++-
 app/scripts/build-manifest.ts       | 26 +++++++++++--
 app/scripts/product-metadata.ts     | 10 ++++-
 docs/development/app.md             | 16 ++++++--
 5 files changed, 123 insertions(+), 10 deletions(-)

