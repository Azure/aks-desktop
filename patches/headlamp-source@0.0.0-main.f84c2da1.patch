diff --git a/source/frontend/src/helpers/getProductInfo.test.ts b/source/frontend/src/helpers/getProductInfo.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c46a372ff4ed74b7f0c691780a8171ea1cd9a729
--- /dev/null
+++ b/source/frontend/src/helpers/getProductInfo.test.ts
@@ -0,0 +1,72 @@
+/*
