+/** Renders the banner for a cluster route, with `suppress` controllable. */
+function renderBanner(checkerFunction: () => Promise<any>, suppress: boolean) {
+  return render(
+    <MemoryRouter initialEntries={['/c/test-cluster/pods']}>
