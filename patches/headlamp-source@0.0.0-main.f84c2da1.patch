new file mode 100644
index 0000000000000000000000000000000000000000..2c8a6073e4d44c6f798916131e41e7fa09f6c94b
--- /dev/null
+++ b/source/frontend/src/components/project/projectGrouping.ts
@@ -0,0 +1,148 @@
