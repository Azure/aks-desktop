+    } finally {
+      process.argv = originalArgv;
+      unregister();
+    }
+  });
+
+  it('dispatches a startup callback on non-macOS platforms', () => {
+    const handleCallback = vi.fn();
+    const protocolHandler = createProtocolHandler({
