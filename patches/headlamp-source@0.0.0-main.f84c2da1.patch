index 0000000000000000000000000000000000000000..e44af12eb6a20d44761481796956e9f12f4b23af
--- /dev/null
+++ b/source/app/e2e-tests/tests/appMenuZoom.spec.ts
@@ -0,0 +1,112 @@
+/*
