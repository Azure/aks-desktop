+
+import { PluginInfo } from './pluginsSlice';
+
+export interface PluginCommandGrant {
+  tool?: string;
+  command?: string;
+  args: string[];
+  allowTrailingArgs?: boolean;
+}
+
+function isShippedPlugin(plugin: PluginInfo): boolean {
+  return plugin.source === 'shipped' || plugin.type === 'shipped';
+}
+
+export function commandGrants(plugin: PluginInfo): PluginCommandGrant[] {
+  if (!isShippedPlugin(plugin)) {
+    return [];
+  }
+  const grants = plugin.headlamp?.capabilities?.runCommands;
+  if (!Array.isArray(grants)) {
+    return [];
+  }
+  return grants.filter(grant => {
+    const command = grant?.tool ?? grant?.command;
+    return (
+      typeof command === 'string' &&
+      command.length > 0 &&
+      Array.isArray(grant.args) &&
+      grant.args.every(arg => typeof arg === 'string') &&
+      (grant.allowTrailingArgs === undefined || typeof grant.allowTrailingArgs === 'boolean')
+    );
+  });
+}
+
+export function commandMatchesGrant(
+  grant: PluginCommandGrant,
+  command: string,
+  args: string[]
+): boolean {
+  const grantedCommand = grant.tool ?? grant.command;
+  if (grantedCommand !== command || args.length < grant.args.length) {
+    return false;
+  }
+  if (!grant.args.every((arg, index) => args[index] === arg)) {
+    return false;
+  }
+  return grant.allowTrailingArgs === true || args.length === grant.args.length;
+}
+
+export function commandCapabilitySecrets(
+  plugin: PluginInfo,
+  secrets: Record<string, number>
+): Record<string, number> {
+  const allowed: Record<string, number> = {};
+  for (const grant of commandGrants(plugin)) {
+    const command = grant.tool ?? grant.command;
+    const secretName = `runCmd-${command}`;
+    if (typeof secrets[secretName] === 'number') {
+      allowed[secretName] = secrets[secretName];
+    }
+  }
+  return allowed;
+}
