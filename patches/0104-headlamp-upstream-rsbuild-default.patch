+	for _, oldPattern := range oldPatterns {
+		content = bytes.ReplaceAll(content, []byte(oldPattern), []byte(newPattern))
+	}
 
 	// Replace any remaining './' patterns in the content.
 	content = bytes.ReplaceAll(content, []byte("'./'"), []byte(h.baseURL+"/"))
