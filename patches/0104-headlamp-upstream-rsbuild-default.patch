     <title data-headlamp-product-name></title>
     <script>var headlampBaseUrl = __baseUrl__;</script>
     <link rel="stylesheet" href="./styles.css">
@@ -2359,6 +2360,7 @@ func TestRewriteIndexHTML(t *testing.T) {
 			expectedOutput: `<!DOCTYPE html>
 <html>
