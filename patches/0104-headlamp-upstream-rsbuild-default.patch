+	oldPatterns := []string{
+		"__baseUrl__ = './<%= BASE_URL %>'.replace('%BASE_' + 'URL%', '').replace('<' + '%= BASE_URL %>', '');",
+		"__baseUrl__ = '%BASE_URL%./'.replace('%BASE_' + 'URL%', '').replace('<' + '%= BASE_URL %>', '');",
+	}
+
 	newPattern := "__baseUrl__ = '" + h.baseURL + "';"
