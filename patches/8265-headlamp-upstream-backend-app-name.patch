 app/electron/build-manifest.test.ts         | 78 +++++++++++++++++++--
 app/electron/main.ts                        |  2 +-
 app/electron/runtimeProductIdentity.test.ts | 14 +++-
 app/scripts/product-metadata.ts             |  8 +++
 docs/development/app.md                     |  8 +++
 6 files changed, 106 insertions(+), 9 deletions(-)

