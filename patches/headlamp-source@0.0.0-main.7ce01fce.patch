+  if (
+    typeof modulePath !== 'string' ||
+    !modulePath.endsWith('.cjs') ||
+    modulePath.includes('\0') ||
+    path.posix.isAbsolute(modulePath) ||
+    path.win32.isAbsolute(modulePath)
