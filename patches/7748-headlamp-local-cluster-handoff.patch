+type LocalRequest =
+  | { action: 'inspect' }
+  | ({ action: 'prepare'; consent: true; distro: typeof LOCAL_DISTRO } & LocalConfiguration)
+  | { action: 'register' | 'discard' | 'verify-delete'; token: string }
+  | {
+      action: 'prepare-delete' | 'forget';
+      reference: string;
+      name: string;
+      credentialFingerprint: string;
+      consent: true;
+      distro: typeof LOCAL_DISTRO;
+    };
+
+interface Lease {
+  token: string;
+  directory: string;
+  kubeconfigPath: string;
+  kind: 'create' | 'verify';
+  configuration: LocalConfiguration;
+  reference: string;
+  target?: LocalTarget;
+  fileRemoved?: boolean;
+}
+
+interface LocalProviderOptions {
+  kubeconfigDirectory: () => string;
+  temporaryDirectory?: string;
+  kubeconfigPaths?: () => string[];
+  hardenDirectory?: (directory: string) => void;
+  hardenFile?: (file: string) => void;
+  persist?: typeof mergeKubeconfigTransaction;
+  platform?: NodeJS.Platform;
+  arch?: string;
+}
+
+const isToken = (value: unknown): value is string =>
+  typeof value === 'string' &&
+  /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/.test(value);
+
+export function isLocalRequest(value: unknown): value is LocalRequest {
+  if (!isRecord(value) || typeof value.action !== 'string') return false;
+  const only = (keys: string[]) => Object.keys(value).every(key => keys.includes(key));
+  if (value.action === 'inspect') return only(['action']);
+  if (['register', 'discard', 'verify-delete'].includes(value.action)) {
+    return only(['action', 'token']) && isToken(value.token);
+  }
+  if (value.consent !== true || value.distro !== LOCAL_DISTRO) return false;
+  if (value.action === 'prepare') {
+    return (
+      only(['action', 'consent', 'distro', 'name', 'kubernetesVersion']) &&
+      isLocalConfiguration(value)
+    );
+  }
+  return (
+    (value.action === 'prepare-delete' || value.action === 'forget') &&
+    only(['action', 'consent', 'distro', 'reference', 'name', 'credentialFingerprint']) &&
+    (value.reference === 'registered' || isToken(value.reference)) &&
+    typeof value.name === 'string' &&
+    /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(value.name) &&
+    typeof value.credentialFingerprint === 'string' &&
+    /^[a-f0-9]{64}$/.test(value.credentialFingerprint)
+  );
+}
+
+/** A capability-scoped file handoff, not an operation journal or process controller. */
+export function createLocalClusterRegistrationProvider(
+  options: LocalProviderOptions
+): ClusterRegistrationProvider<LocalRequest> {
+  const leases = new Map<string, Lease>();
+  const hardenDirectory = options.hardenDirectory ?? enforcePrivateDirectoryPermissions;
+  const hardenFile = options.hardenFile ?? enforcePrivateFilePermissions;
+  const persist = options.persist ?? mergeKubeconfigTransaction;
+  let requestInFlight = false;
+  let deletionPermit: { reference: string; digest: string; target: LocalTarget } | undefined;
+
+  const managedPath = () => {
+    const directory = options.kubeconfigDirectory();
+    if (!path.isAbsolute(directory)) throw new LocalHandoffError('storage');
+    return path.join(directory, LOCAL_CONFIG_FILE);
+  };
+  const managedTarget = (): LocalTarget | null => {
+    try {
+      return readRegisteredLocalTarget(readPrivateKubeconfig(managedPath()));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+      throw error;
+    }
+  };
+  const leaseDirectory = (lease: Lease) => {
+    if (fs.realpathSync(lease.directory) !== lease.directory) {
+      throw new LocalHandoffError('identity-mismatch');
+    }
+  };
+  const discard = (lease: Lease) => {
+    try {
+      leaseDirectory(lease);
+      if (!lease.fileRemoved) {
+        try {
+          fs.unlinkSync(lease.kubeconfigPath);
+        } catch (error) {
+          if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+        }
+        lease.fileRemoved = true;
+      }
+      fs.rmdirSync(lease.directory);
+      leases.delete(lease.token);
+    } catch {
+      throw new LocalHandoffError('cleanup');
+    }
+  };
+  const allocate = (
+    kind: Lease['kind'],
+    configuration: LocalConfiguration,
+    reference = ''
+  ): Lease => {
+    if (leases.size >= 2 || [...leases.values()].some(lease => lease.kind === kind)) {
+      throw new LocalHandoffError('busy');
+    }
+    const token = randomUUID();
+    const directory = path.join(
+      options.temporaryDirectory ?? os.tmpdir(),
+      `aksedge-kubeconfig-${token}`
+    );
+    fs.mkdirSync(directory, { mode: 0o700 });
+    const kubeconfigPath = path.join(directory, 'credentials.yaml');
+    let createdFile = false;
+    try {
+      hardenDirectory(directory);
+      fs.closeSync(fs.openSync(kubeconfigPath, 'wx', 0o600));
+      createdFile = true;
+      hardenFile(kubeconfigPath);
+      const canonicalDirectory = fs.realpathSync(directory);
+      const lease: Lease = {
+        token,
+        directory: canonicalDirectory,
+        kubeconfigPath: path.join(canonicalDirectory, 'credentials.yaml'),
+        kind,
+        configuration: {
+          name: configuration.name,
+          kubernetesVersion: configuration.kubernetesVersion,
+        },
+        reference: reference || token,
+      };
+      leases.set(token, lease);
+      return lease;
+    } catch {
+      try {
+        if (createdFile) fs.unlinkSync(kubeconfigPath);
+        fs.rmdirSync(directory);
+      } catch {
+        throw new LocalHandoffError('cleanup');
+      }
+      throw new LocalHandoffError('storage');
+    }
+  };
+  const findLease = (token: string): Lease => {
+    const lease = leases.get(token);
+    if (!lease) throw new LocalHandoffError('identity-mismatch');
+    leaseDirectory(lease);
+    return lease;
+  };
+  const source = (reference: string) => {
+    let contents: string;
+    let target: LocalTarget;
+    if (reference === 'registered') {
+      contents = readPrivateKubeconfig(managedPath());
+      target = readRegisteredLocalTarget(contents);
+    } else {
+      const lease = findLease(reference);
+      if (lease.kind !== 'create' || !lease.target) {
+        throw new LocalHandoffError('identity-mismatch');
+      }
+      contents = readPrivateKubeconfig(lease.kubeconfigPath);
+      target = normalizeLocalKubeconfig(contents, lease.configuration, reference).target;
+    }
+    return { target, digest: createHash('sha256').update(contents).digest('hex') };
+  };
+  const collisionPaths = () => {
+    const directory = path.dirname(managedPath());
+    const entries = fs.readdirSync(directory, { withFileTypes: true });
+    const managed = entries
+      .filter(
+        entry => entry.name !== LOCAL_CONFIG_FILE && (entry.isFile() || entry.isSymbolicLink())
+      )
+      .map(entry => path.join(directory, entry.name));
+    return [
+      ...new Set([...(options.kubeconfigPaths ?? resolveKubeconfigPaths)(), ...managed]),
+    ].filter(candidate => path.resolve(candidate) !== managedPath());
+  };
+  const prepared = (lease: Lease) => ({
+    token: lease.token,
+    kubeconfigPath: lease.kubeconfigPath,
+  });
+
+  return {
+    id: LOCAL_PROVIDER,
+    validateOptions: isLocalRequest,
+    async register(request) {
+      if (
+        (options.platform ?? process.platform) !== 'win32' ||
+        (options.arch ?? process.arch) !== 'x64'
+      ) {
+        return {
+          success: false,
+          message: 'Local clusters require Windows x64.',
+          data: { code: 'unsupported' },
+        };
+      }
+      if (requestInFlight) {
+        return {
+          success: false,
+          message: 'A native handoff is already in progress.',
+          data: { code: 'busy' },
+        };
+      }
+      requestInFlight = true;
+      try {
+        switch (request.action) {
+          case 'inspect': {
+            const pending = [...leases.values()].find(lease => lease.kind === 'create')?.target;
+            return {
+              success: true,
+              message: 'Local target inspected.',
+              data: { target: managedTarget() ?? pending ?? null },
+            };
+          }
+          case 'prepare': {
+            if (managedTarget()) throw new LocalHandoffError('already-exists');
+            const lease = allocate('create', request);
+            return {
+              success: true,
+              message: 'Private credential destination prepared.',
+              data: prepared(lease),
+            };
+          }
+          case 'register': {
+            const lease = findLease(request.token);
+            if (lease.kind !== 'create') throw new LocalHandoffError('identity-mismatch');
+            const imported = managedTarget();
+            if (
+              lease.target &&
+              imported &&
+              imported.name === lease.target.name &&
+              imported.kubernetesVersion === lease.target.kubernetesVersion &&
+              imported.credentialFingerprint === lease.target.credentialFingerprint
+            ) {
+              discard(lease);
+              return {
+                success: true,
+                message: 'Local credentials imported into Desktop.',
+                data: { target: imported },
+              };
+            }
+            const normalized = normalizeLocalKubeconfig(
+              readPrivateKubeconfig(lease.kubeconfigPath),
+              lease.configuration,
+              lease.token
+            );
+            lease.target = normalized.target;
+            const existing = managedTarget();
+            if (
+              existing &&
+              (existing.name !== normalized.target.name ||
+                existing.kubernetesVersion !== normalized.target.kubernetesVersion ||
+                existing.credentialFingerprint !== normalized.target.credentialFingerprint)
+            ) {
+              throw new LocalHandoffError('already-exists');
+            }
+            fs.mkdirSync(path.dirname(managedPath()), { recursive: true, mode: 0o700 });
+            const others = collisionPaths();
+            for (const file of others) {
+              try {
+                assertNoLocalContextCollision(
+                  normalized.target.contextName,
+                  fs.readFileSync(file, 'utf8')
+                );
+              } catch (error) {
+                if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+              }
+            }
+            await persist(normalized.contents, [managedPath(), ...others]);
+            const target = managedTarget();
+            if (
+              !target ||
+              target.credentialFingerprint !== normalized.target.credentialFingerprint
+            ) {
+              throw new LocalHandoffError('storage');
+            }
+            discard(lease);
+            return {
+              success: true,
+              message: 'Local credentials imported into Desktop.',
+              data: { target },
+            };
+          }
+          case 'discard': {
+            discard(findLease(request.token));
+            return { success: true, message: 'Temporary credential handoff removed.' };
+          }
+          case 'prepare-delete': {
+            deletionPermit = undefined;
+            const current = source(request.reference);
+            if (
+              current.target.name !== request.name ||
+              current.target.credentialFingerprint !== request.credentialFingerprint
+            ) {
+              throw new LocalHandoffError('identity-mismatch');
+            }
+            const lease = allocate('verify', current.target, request.reference);
+            lease.target = current.target;
+            return {
+              success: true,
+              message: 'Private identity check prepared.',
+              data: prepared(lease),
+            };
+          }
+          case 'verify-delete': {
+            const lease = findLease(request.token);
+            if (lease.kind !== 'verify' || !lease.target) {
+              throw new LocalHandoffError('identity-mismatch');
+            }
+            const fetched = normalizeLocalKubeconfig(
+              readPrivateKubeconfig(lease.kubeconfigPath),
+              lease.configuration,
+              lease.reference
+            ).target;
+            const current = source(lease.reference);
+            if (
+              fetched.credentialFingerprint !== lease.target.credentialFingerprint ||
+              current.target.credentialFingerprint !== lease.target.credentialFingerprint ||
+              current.target.name !== lease.target.name ||
+              current.target.kubernetesVersion !== lease.target.kubernetesVersion
+            ) {
+              throw new LocalHandoffError('identity-mismatch');
+            }
+            discard(lease);
+            deletionPermit = {
+              reference: lease.reference,
+              digest: current.digest,
+              target: current.target,
+            };
+            return { success: true, message: 'The current guest credential identity matches.' };
+          }
+          case 'forget': {
+            const pendingLease =
+              request.reference === 'registered' ? undefined : findLease(request.reference);
+            // After an unlink succeeded, a retry may only remove the now-empty private directory.
+            const current =
+              pendingLease?.fileRemoved && deletionPermit?.reference === request.reference
+                ? deletionPermit
+                : source(request.reference);
+            if (
+              current.target.name !== request.name ||
+              current.target.credentialFingerprint !== request.credentialFingerprint ||
+              deletionPermit?.reference !== request.reference ||
+              deletionPermit.digest !== current.digest
+            ) {
+              throw new LocalHandoffError('identity-mismatch');
+            }
+            if (request.reference === 'registered') {
+              for (const lease of leases.values()) {
+                if (
+                  lease.kind === 'create' &&
+                  lease.target?.name === current.target.name &&
+                  lease.target.credentialFingerprint === current.target.credentialFingerprint
+                ) {
+                  discard(lease);
+                }
+              }
+              fs.unlinkSync(managedPath());
+            } else {
+              discard(findLease(request.reference));
+            }
+            deletionPermit = undefined;
+            return { success: true, message: 'Only the matching local Desktop entry was removed.' };
+          }
+        }
+      } catch (error) {
+        const code = error instanceof LocalHandoffError ? error.code : 'storage';
+        return {
+          success: false,
+          message: `Local cluster handoff failed (${code}).`,
+          data: { code },
+        };
+      } finally {
+        requestInFlight = false;
+      }
+    },
+  };
+}
