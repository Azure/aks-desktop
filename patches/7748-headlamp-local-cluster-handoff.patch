+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import yaml from 'yaml';
+import {
+  ClusterRegistrationResult,
+  mergeKubeconfigTransaction,
+  registerCluster,
+} from './cluster-registration';
+import {
+  createLocalClusterRegistrationProvider,
+  isLocalRequest,
+} from './local-cluster-registration';
+import { LOCAL_CONFIG_FILE, readRegisteredLocalTarget } from './local-kubeconfig';
+
+vi.mock('./secureStorage', () => ({ isTrustedDocumentUrl: vi.fn() }));
+
+const configuration = { name: 'demo', kubernetesVersion: '1.36.1-20260701' };
+const consent = { consent: true as const, distro: 'Ubuntu-24.04' as const };
+const runtime = { resourcesPath: 'unused', tools: { cli: 'unused' } };
+function credentials(identity = 'public-test-certificate') {
+  return yaml.stringify({
+    apiVersion: 'v1',
+    kind: 'Config',
+    clusters: [
+      {
+        name: 'demo',
+        cluster: { server: 'https://localhost:6443', 'insecure-skip-tls-verify': true },
+      },
+    ],
+    contexts: [{ name: 'demo', context: { cluster: 'demo', user: 'admin' } }],
+    users: [
+      {
+        name: 'admin',
+        user: {
+          'client-certificate-data': Buffer.from(identity).toString('base64'),
+          'client-key-data': Buffer.from('synthetic-test-key-not-a-real-credential').toString(
+            'base64'
+          ),
+        },
+      },
+    ],
+    'current-context': 'demo',
+  });
+}
+function preparation(result: ClusterRegistrationResult) {
+  if (
+    !result.success ||
+    typeof result.data?.token !== 'string' ||
+    typeof result.data.kubeconfigPath !== 'string'
+  ) {
+    throw new Error('Fixture expected a successful preparation');
+  }
+  return { token: result.data.token, kubeconfigPath: result.data.kubeconfigPath };
+}
+
+describe('local registration handoff', () => {
+  let root: string;
+  let destination: string;
+  let normalConfig: string;
+  let provider: ReturnType<typeof createLocalClusterRegistrationProvider>;
+  const hardenDirectory = vi.fn<(directory: string) => void>();
+  const hardenFile = vi.fn<(file: string) => void>();
+  const persist = vi.fn<typeof mergeKubeconfigTransaction>();
+  const call = (request: Parameters<typeof provider.register>[0]) =>
+    provider.register(request, runtime);
+  const prepareCreate = async () =>
+    preparation(await call({ action: 'prepare', ...configuration, ...consent }));
+
+  beforeEach(() => {
+    root = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'local-handoff-')));
+    destination = path.join(root, 'desktop', LOCAL_CONFIG_FILE);
+    normalConfig = path.join(root, 'normal-config');
+    fs.writeFileSync(
+      normalConfig,
+      'apiVersion: v1\nkind: Config\ncontexts: []\nclusters: []\nusers: []\n'
+    );
+    hardenDirectory.mockReset();
+    hardenFile.mockReset().mockImplementation(file => {
+      expect(fs.statSync(file).size).toBe(0);
+    });
+    persist.mockReset().mockImplementation(mergeKubeconfigTransaction);
+    provider = createLocalClusterRegistrationProvider({
+      kubeconfigDirectory: () => path.dirname(destination),
+      temporaryDirectory: root,
+      kubeconfigPaths: () => [normalConfig],
+      hardenDirectory,
+      hardenFile,
+      persist,
+      platform: 'win32',
+      arch: 'x64',
+    });
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+
+  async function importFixture() {
+    const prepared = await prepareCreate();
+    fs.writeFileSync(prepared.kubeconfigPath, credentials());
+    const result = await call({ action: 'register', token: prepared.token });
+    expect(result.success).toBe(true);
+    return readRegisteredLocalTarget(fs.readFileSync(destination, 'utf8'));
+  }
+  async function verifyTarget(reference: string, fingerprint: string, identity?: string) {
+    const prepared = preparation(
+      await call({
+        action: 'prepare-delete',
+        reference,
+        name: configuration.name,
+        credentialFingerprint: fingerprint,
+        ...consent,
+      })
+    );
+    fs.writeFileSync(prepared.kubeconfigPath, credentials(identity));
+    return { prepared, result: await call({ action: 'verify-delete', token: prepared.token }) };
+  }
+
+  it('hardens an empty private handoff before writing and uses shared persistence without changing normal config', async () => {
+    const before = fs.readFileSync(normalConfig, 'utf8');
+    const prepared = await prepareCreate();
+    expect(hardenDirectory).toHaveBeenCalledWith(path.dirname(prepared.kubeconfigPath));
+    expect(hardenFile).toHaveBeenCalledWith(prepared.kubeconfigPath);
+    expect(hardenDirectory.mock.invocationCallOrder[0]).toBeLessThan(
+      hardenFile.mock.invocationCallOrder[0]
+    );
+    fs.writeFileSync(prepared.kubeconfigPath, credentials());
+    const result = await call({ action: 'register', token: prepared.token });
+    expect(result).toMatchObject({
+      success: true,
+      data: { target: { contextName: 'aksedge-demo', registered: true } },
+    });
+    expect(persist.mock.calls[0][1]).toEqual([destination, normalConfig]);
+    expect(fs.readFileSync(normalConfig, 'utf8')).toBe(before);
+    expect(fs.existsSync(path.dirname(prepared.kubeconfigPath))).toBe(false);
+    expect(JSON.stringify(result)).not.toContain('client-key');
+    expect(await call({ action: 'prepare', ...configuration, ...consent })).toMatchObject({
+      success: false,
+      data: { code: 'already-exists' },
+    });
+  });
+
+  it('preserves public metadata through the generic dispatcher without changing existing provider results', async () => {
+    expect(
+      await registerCluster('aksedge-local', { action: 'inspect' }, runtime, [provider])
+    ).toEqual({
+      success: true,
+      message: 'Local target inspected.',
+      data: { target: null },
+    });
+    const register = vi
+      .fn()
+      .mockResolvedValue({ success: true, message: 'Existing provider result' });
+    const existing = { ...provider, id: 'existing', register };
+    expect(await registerCluster('existing', { action: 'inspect' }, runtime, [existing])).toEqual({
+      success: true,
+      message: 'Existing provider result',
+    });
+    for (const data of [null, [], 'unexpected']) {
+      register.mockResolvedValueOnce({ success: true, message: 'fixture', data });
+      expect(
+        await registerCluster('existing', { action: 'inspect' }, runtime, [existing])
+      ).toMatchObject({
+        success: false,
+      });
+    }
+  });
+
+  it('rejects unknown valid-looking tokens and cleans failed initial permission setup', async () => {
+    expect(
+      await call({ action: 'register', token: 'f0000000-0000-4000-8000-000000000000' })
+    ).toMatchObject({
+      success: false,
+      data: { code: 'identity-mismatch' },
+    });
+    hardenFile.mockImplementationOnce(() => {
+      throw new Error('SECRET');
+    });
+    const result = await call({ action: 'prepare', ...configuration, ...consent });
+    expect(result).toMatchObject({ success: false, data: { code: 'storage' } });
+    expect(JSON.stringify(result)).not.toContain('SECRET');
+    expect(fs.readdirSync(root).filter(name => name.startsWith('aksedge-kubeconfig-'))).toEqual([]);
+  });
+
+  it('blocks concurrent preparations', async () => {
+    await prepareCreate();
+    expect(await call({ action: 'prepare', ...configuration, ...consent })).toMatchObject({
+      success: false,
+      data: { code: 'busy' },
+    });
+  });
+
+  it('refuses unsupported hosts before touching any credentials', async () => {
+    const unsupported = createLocalClusterRegistrationProvider({
+      kubeconfigDirectory: () => path.dirname(destination),
+      hardenDirectory,
+      hardenFile,
+      platform: 'win32',
+      arch: 'arm64',
+    });
+    expect(await unsupported.register({ action: 'inspect' }, runtime)).toMatchObject({
+      success: false,
+      data: { code: 'unsupported' },
+    });
+    expect(hardenDirectory).not.toHaveBeenCalled();
+    expect(hardenFile).not.toHaveBeenCalled();
+  });
+
+  it('serializes in-flight native requests before allocating private output', async () => {
+    const prepared = await prepareCreate();
+    fs.writeFileSync(prepared.kubeconfigPath, credentials());
+    hardenFile.mockClear();
+    let complete: () => void = () => undefined;
+    persist.mockImplementationOnce(async (...args) => {
+      await new Promise<void>(resolve => {
+        complete = resolve;
+      });
+      return mergeKubeconfigTransaction(...args);
+    });
+    const pending = call({ action: 'register', token: prepared.token });
+    expect(await call({ action: 'prepare', ...configuration, ...consent })).toMatchObject({
+      success: false,
+      data: { code: 'busy' },
+    });
+    expect(hardenFile).not.toHaveBeenCalled();
+    complete();
+    expect(await pending).toMatchObject({ success: true });
+  });
+
+  it('keeps a failed import available for retry without running create again', async () => {
+    const prepared = await prepareCreate();
+    fs.writeFileSync(prepared.kubeconfigPath, credentials());
+    persist.mockRejectedValueOnce(new Error('SECRET path and credential'));
+    expect(await call({ action: 'register', token: prepared.token })).toMatchObject({
+      success: false,
+      data: { code: 'storage' },
+    });
+    expect(fs.existsSync(prepared.kubeconfigPath)).toBe(true);
+    expect(await call({ action: 'inspect' })).toMatchObject({
+      success: true,
+      data: { target: { reference: prepared.token, registered: false } },
+    });
+    expect(await call({ action: 'register', token: prepared.token })).toMatchObject({
+      success: true,
+    });
+    expect(hardenFile).toHaveBeenCalledTimes(1);
+  });
+
+  it('allows a validated pending target to be removed even when import failed', async () => {
+    const prepared = await prepareCreate();
+    fs.writeFileSync(prepared.kubeconfigPath, credentials());
+    persist.mockRejectedValueOnce(new Error('fixture persistence failure'));
+    await call({ action: 'register', token: prepared.token });
+    const inspected = await call({ action: 'inspect' });
+    const target = inspected.data?.target;
+    if (
+      !target ||
+      typeof target !== 'object' ||
+      !('credentialFingerprint' in target) ||
+      typeof target.credentialFingerprint !== 'string'
+    )
+      throw new Error('Expected pending target');
+    const { result } = await verifyTarget(prepared.token, target.credentialFingerprint);
+    expect(result.success).toBe(true);
+    expect(
+      await call({
+        action: 'forget',
+        reference: prepared.token,
+        name: 'demo',
+        credentialFingerprint: target.credentialFingerprint,
+        ...consent,
+      })
+    ).toMatchObject({ success: true });
+    expect(fs.existsSync(prepared.kubeconfigPath)).toBe(false);
+    expect(fs.existsSync(destination)).toBe(false);
+  });
+
+  it('refuses changed live credentials and removes no Desktop entry', async () => {
+    const target = await importFixture();
+    const before = fs.readFileSync(destination, 'utf8');
+    const { result } = await verifyTarget(
+      'registered',
+      target.credentialFingerprint,
+      'another-certificate'
+    );
+    expect(result).toMatchObject({ success: false, data: { code: 'identity-mismatch' } });
+    expect(
+      await call({
+        action: 'forget',
+        reference: 'registered',
+        name: 'demo',
+        credentialFingerprint: target.credentialFingerprint,
+        ...consent,
+      })
+    ).toMatchObject({ success: false });
+    expect(fs.readFileSync(destination, 'utf8')).toBe(before);
+  });
+
+  it('binds removal to the exact verified source bytes and never deletes another config', async () => {
+    const target = await importFixture();
+    const before = fs.readFileSync(normalConfig, 'utf8');
+    expect((await verifyTarget('registered', target.credentialFingerprint)).result.success).toBe(
+      true
+    );
+    fs.appendFileSync(destination, '\n# independently changed\n');
+    expect(
+      await call({
+        action: 'forget',
+        reference: 'registered',
+        name: 'demo',
+        credentialFingerprint: target.credentialFingerprint,
+        ...consent,
+      })
+    ).toMatchObject({
+      success: false,
+      data: { code: 'identity-mismatch' },
+    });
+    expect(fs.existsSync(destination)).toBe(true);
+    expect((await verifyTarget('registered', target.credentialFingerprint)).result.success).toBe(
+      true
+    );
+    expect(
+      await call({
+        action: 'forget',
+        reference: 'registered',
+        name: 'demo',
+        credentialFingerprint: target.credentialFingerprint,
+        ...consent,
+      })
+    ).toMatchObject({ success: true });
+    expect(fs.existsSync(destination)).toBe(false);
+    expect(fs.readFileSync(normalConfig, 'utf8')).toBe(before);
+  });
+
+  it('retries private cleanup after persistence succeeded and the temp file was already unlinked', async () => {
+    const prepared = await prepareCreate();
+    fs.writeFileSync(prepared.kubeconfigPath, credentials());
+    const remove = vi.spyOn(fs, 'rmdirSync').mockImplementationOnce(() => {
+      throw new Error('fixture cleanup failure');
+    });
+    expect(await call({ action: 'register', token: prepared.token })).toMatchObject({
+      success: false,
+      data: { code: 'cleanup' },
+    });
+    expect(fs.existsSync(destination)).toBe(true);
+    expect(fs.existsSync(prepared.kubeconfigPath)).toBe(false);
+    remove.mockRestore();
+    expect(await call({ action: 'register', token: prepared.token })).toMatchObject({
+      success: true,
+    });
+    expect(persist).toHaveBeenCalledTimes(1);
+  });
+
+  it('retries pending-target removal after unlink without removing a newly appeared file', async () => {
+    const prepared = await prepareCreate();
+    fs.writeFileSync(prepared.kubeconfigPath, credentials());
+    persist.mockRejectedValueOnce(new Error('fixture persistence failure'));
+    await call({ action: 'register', token: prepared.token });
+    const inspected = await call({ action: 'inspect' });
+    const target = inspected.data?.target;
+    if (
+      !target ||
+      typeof target !== 'object' ||
+      !('credentialFingerprint' in target) ||
+      typeof target.credentialFingerprint !== 'string'
+    )
+      throw new Error('Expected pending target');
+    expect((await verifyTarget(prepared.token, target.credentialFingerprint)).result.success).toBe(
+      true
+    );
+    const request = {
+      action: 'forget' as const,
+      reference: prepared.token,
+      name: 'demo',
+      credentialFingerprint: target.credentialFingerprint,
+      ...consent,
+    };
+    const remove = vi.spyOn(fs, 'rmdirSync').mockImplementationOnce(() => {
+      throw new Error('fixture cleanup failure');
+    });
+    expect(await call(request)).toMatchObject({ success: false, data: { code: 'cleanup' } });
+    expect(fs.existsSync(prepared.kubeconfigPath)).toBe(false);
+    remove.mockRestore();
+    fs.writeFileSync(prepared.kubeconfigPath, 'independently created file');
+    expect(await call(request)).toMatchObject({ success: false, data: { code: 'cleanup' } });
+    expect(fs.readFileSync(prepared.kubeconfigPath, 'utf8')).toBe('independently created file');
+    fs.unlinkSync(prepared.kubeconfigPath);
+    expect(await call(request)).toMatchObject({ success: true });
+    expect(fs.existsSync(path.dirname(prepared.kubeconfigPath))).toBe(false);
+  });
+
+  it('refuses an unrelated file at the managed destination and refuses context collisions', async () => {
+    const prepared = await prepareCreate();
+    fs.writeFileSync(prepared.kubeconfigPath, credentials());
+    fs.writeFileSync(normalConfig, 'contexts:\n- name: aksedge-demo\n  context: {}\n');
+    expect(await call({ action: 'register', token: prepared.token })).toMatchObject({
+      success: false,
+      data: { code: 'collision' },
+    });
+    expect(persist).not.toHaveBeenCalled();
+    fs.writeFileSync(destination, credentials());
+    const before = fs.readFileSync(destination, 'utf8');
+    expect(await call({ action: 'inspect' })).toMatchObject({ success: false });
+    expect(fs.readFileSync(destination, 'utf8')).toBe(before);
+  });
+
+  it('rejects unknown tokens, extra options, alternate distributions and non-string actions', () => {
+    expect(isLocalRequest({ action: 'inspect' })).toBe(true);
+    expect(isLocalRequest({ action: 'prepare', ...configuration, ...consent })).toBe(true);
+    for (const value of [
+      { action: ['inspect'] },
+      { action: ['register'], token: 'f0000000-0000-4000-8000-000000000000' },
+      { action: 'inspect', path: 'C:\\arbitrary' },
+      { action: 'prepare', ...configuration, ...consent, distro: 'PersonalUbuntu' },
+      { action: 'prepare', ...configuration, ...consent, consent: false },
+      { action: 'discard', token: '..' },
+      { action: 'register', token: 'f0000000-0000-4000-8000-000000000000', kubeconfig: 'SECRET' },
+    ])
+      expect(isLocalRequest(value)).toBe(false);
+  });
+});
