+package kubeconfig_test
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/kubernetes-sigs/headlamp/backend/pkg/kubeconfig"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"k8s.io/client-go/tools/clientcmd"
+	clientcmdapi "k8s.io/client-go/tools/clientcmd/api"
+)
+
+func writeDiscoveryConfig(t *testing.T, file, name string) {
+	t.Helper()
+
+	config := clientcmdapi.Config{
+		Clusters: map[string]*clientcmdapi.Cluster{
+			name: {Server: "https://127.0.0.1:65535", InsecureSkipTLSVerify: true},
+		},
+		AuthInfos: map[string]*clientcmdapi.AuthInfo{
+			name: {Token: "synthetic-discovery-test-token"},
+		},
+		Contexts: map[string]*clientcmdapi.Context{
+			name: {Cluster: name, AuthInfo: name},
+		},
+		CurrentContext: name,
+	}
+	require.NoError(t, clientcmd.WriteToFile(config, file))
+}
+
+func TestDiscoveryWithMissingKubeconfigPaths(t *testing.T) {
+	for _, missingFirst := range []bool{false, true} {
+		name := "missing-last"
+		if missingFirst {
+			name = "missing-first"
+		}
+
+		t.Run(name, func(t *testing.T) {
+			root := t.TempDir()
+			existing := filepath.Join(root, "ordinary-config")
+			missing := filepath.Join(root, "private-config")
+			writeDiscoveryConfig(t, existing, "ordinary")
+			paths := []string{existing, missing}
+			if missingFirst {
+				paths = []string{missing, existing}
+			}
+
+			contexts, contextErrors, err := kubeconfig.LoadContextsFromMultipleFiles(
+				strings.Join(paths, string(os.PathListSeparator)), kubeconfig.KubeConfig)
+			require.NoError(t, err)
+			require.Empty(t, contextErrors)
+			require.Len(t, contexts, 1)
+			require.Equal(t, "ordinary", contexts[0].Name)
+			require.Equal(t, existing, contexts[0].KubeConfigPath)
+
+			writeDiscoveryConfig(t, missing, "private")
+			contexts, contextErrors, err = kubeconfig.LoadContextsFromMultipleFiles(
+				strings.Join(paths, string(os.PathListSeparator)), kubeconfig.KubeConfig)
+			require.NoError(t, err)
+			require.Empty(t, contextErrors)
+			require.Len(t, contexts, 2)
+		})
+	}
+}
+
+func TestDiscoveryDoesNotHideAllMissingOrInvalidFiles(t *testing.T) {
+	root := t.TempDir()
+	existing := filepath.Join(root, "ordinary-config")
+	writeDiscoveryConfig(t, existing, "ordinary")
+	missing := filepath.Join(root, "missing-config")
+	missingPaths := strings.Join([]string{missing, missing + "-second"}, string(os.PathListSeparator))
+	_, _, err := kubeconfig.LoadContextsFromMultipleFiles(missingPaths, kubeconfig.KubeConfig)
+	require.ErrorIs(t, err, os.ErrNotExist)
+
+	invalid := filepath.Join(root, "invalid-config")
+	require.NoError(t, os.WriteFile(invalid, []byte("contexts: [invalid"), 0o600))
+
+	for _, invalidPath := range []string{invalid, root} {
+		paths := strings.Join([]string{existing, invalidPath}, string(os.PathListSeparator))
+		_, _, err := kubeconfig.LoadContextsFromMultipleFiles(paths, kubeconfig.KubeConfig)
+		require.Error(t, err)
+		require.False(t, errors.Is(err, os.ErrNotExist))
+	}
+}
+
+func TestDiscoveryWatcherReconcilesUnobservedRemoval(t *testing.T) {
+	for _, ordinaryExists := range []bool{true, false} {
+		name := "ordinary-absent"
+		if ordinaryExists {
+			name = "ordinary-present"
+		}
+
+		t.Run(name, func(t *testing.T) {
+			root := t.TempDir()
+			ordinary := filepath.Join(root, "ordinary-config")
+			private := filepath.Join(root, "private-config")
+			var expected []string
+
+			if ordinaryExists {
+				writeDiscoveryConfig(t, ordinary, "ordinary")
+				expected = append(expected, "ordinary")
+			}
+
+			writeDiscoveryConfig(t, private, "private")
+			paths := strings.Join([]string{ordinary, private}, string(os.PathListSeparator))
+			store := kubeconfig.NewContextStore()
+			require.NoError(t, kubeconfig.LoadAndStoreKubeConfigs(store, paths, kubeconfig.KubeConfig, nil))
+			_, err := store.GetContext("private")
+			require.NoError(t, err)
+
+			// No file event can be observed for a removal before the watch is attached.
+			require.NoError(t, os.Remove(private))
+			ctx, cancel := context.WithCancel(context.Background())
+			stopped := make(chan struct{})
+
+			go func() {
+				defer close(stopped)
+				kubeconfig.LoadAndWatchFiles(ctx, store, paths, kubeconfig.KubeConfig, nil)
+			}()
+
+			t.Cleanup(func() {
+				cancel()
+				<-stopped
+			})
+
+			require.EventuallyWithT(t, func(collect *assert.CollectT) {
+				contexts, err := store.GetContexts()
+				require.NoError(collect, err)
+				var actual []string
+				for _, current := range contexts {
+					actual = append(actual, current.Name)
+				}
+				require.ElementsMatch(collect, expected, actual)
+			}, 20*time.Second, 100*time.Millisecond)
+		})
+	}
+}
