+
+import { createHash } from 'node:crypto';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import yaml from 'yaml';
+import {
+  assertNoLocalContextCollision,
+  normalizeLocalKubeconfig,
+  readPrivateKubeconfig,
+  readRegisteredLocalTarget,
+  withLocalKubeconfigPath,
+} from './local-kubeconfig';
+
+vi.mock('./secureStorage', () => ({ isTrustedDocumentUrl: vi.fn() }));
+
+const configuration = { name: 'demo', kubernetesVersion: '1.36.1-20260701' };
+const certificate = Buffer.from('synthetic-public-certificate').toString('base64');
+const key = Buffer.from('synthetic-test-key-not-a-real-credential').toString('base64');
+function config() {
+  return {
+    apiVersion: 'v1',
+    kind: 'Config',
+    clusters: [
+      {
+        name: 'demo',
+        cluster: { server: 'https://localhost:6443', 'insecure-skip-tls-verify': true },
+      },
+    ],
+    contexts: [
+      {
+        name: 'demo',
+        context: {
+          cluster: 'demo',
+          user: 'admin',
+          extensions: [
+            {
+              name: 'context_info',
+              extension: { provider: 'baremetal.aksarc.microsoft.com', unwanted: 'dropped' },
+            },
+          ],
+        },
+      },
+    ],
+    users: [
+      { name: 'admin', user: { 'client-certificate-data': certificate, 'client-key-data': key } },
+    ],
+    'current-context': 'demo',
+  };
+}
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllEnvs();
+});
+
+describe('local kubeconfig discovery paths', () => {
+  const directory = path.join(os.tmpdir(), 'local-discovery-paths');
+  const managed = path.join(directory, 'aksedge-local.yaml');
+  const first = path.join(directory, 'first config');
+  const second = path.join(directory, 'second config');
+  const resolve = (configured?: string) =>
+    withLocalKubeconfigPath(configured, directory, 'win32', 'x64')?.split(path.delimiter);
+
+  it('preserves explicit paths and appends the private store without touching files', () => {
+    vi.stubEnv('HEADLAMP_CONFIG_KUBECONFIG', 'unused-prefixed-path');
+    vi.stubEnv('KUBECONFIG', 'unused-environment-path');
+    const read = vi.spyOn(fs, 'readFileSync');
+    const write = vi.spyOn(fs, 'writeFileSync');
+    expect(resolve([first, second].join(path.delimiter))).toEqual([first, second, managed]);
+    expect(read).not.toHaveBeenCalled();
+    expect(write).not.toHaveBeenCalled();
+  });
+
+  it('preserves the backend-specific environment override before KUBECONFIG', () => {
+    vi.stubEnv('HEADLAMP_CONFIG_KUBECONFIG', first);
+    vi.stubEnv('KUBECONFIG', second);
+    expect(resolve()).toEqual([first, managed]);
+  });
+
+  it('preserves all KUBECONFIG entries when no explicit override is set', () => {
+    vi.stubEnv('HEADLAMP_CONFIG_KUBECONFIG', '');
+    vi.stubEnv('KUBECONFIG', [first, second].join(path.delimiter));
+    expect(resolve()).toEqual([first, second, managed]);
+  });
+
+  it('retains the ordinary home kubeconfig fallback', () => {
+    vi.stubEnv('HEADLAMP_CONFIG_KUBECONFIG', '');
+    vi.stubEnv('KUBECONFIG', '');
+    expect(resolve()).toEqual([path.join(os.homedir(), '.kube', 'config'), managed]);
+  });
+
+  it('does not duplicate the managed file under Windows case-insensitive identity', () => {
+    expect(resolve([first, managed.toUpperCase()].join(path.delimiter))).toEqual([
+      first,
+      managed.toUpperCase(),
+    ]);
+  });
+
+  it.each([
+    ['linux', 'x64'],
+    ['darwin', 'arm64'],
+    ['win32', 'arm64'],
+  ] as const)('does not change %s/%s discovery', (platform, arch) => {
+    expect(withLocalKubeconfigPath(first, directory, platform, arch)).toBe(first);
+    expect(withLocalKubeconfigPath(undefined, directory, platform, arch)).toBeUndefined();
+  });
+});
+
+describe('private local credentials', () => {
+  it('normalizes local names, drops Arc classification and returns no secret in public metadata', () => {
+    const normalized = normalizeLocalKubeconfig(yaml.stringify(config()), configuration, 'lease');
+    const parsed = yaml.parse(normalized.contents);
+    expect(parsed['current-context']).toBe('aksedge-demo');
+    expect(parsed.contexts[0].context).toMatchObject({
+      cluster: 'aksedge-demo',
+      user: 'aksedge-demo-admin',
+    });
+    expect(parsed.contexts[0].context.extensions).toEqual([
+      {
+        name: 'context_info',
+        extension: {
+          provider: 'aksedge-local',
+          distro: 'Ubuntu-24.04',
+          ...configuration,
+          credentialFingerprint: createHash('sha256')
+            .update(Buffer.from(certificate, 'base64'))
+            .digest('hex'),
+        },
+      },
+    ]);
+    expect(normalized.contents).not.toContain('baremetal.aksarc.microsoft.com');
+    expect(parsed.clusters[0].cluster['insecure-skip-tls-verify']).toBe(true);
+    expect(JSON.stringify(normalized.target)).not.toContain(key);
+    expect(JSON.stringify(normalized.target)).not.toContain(certificate);
+    expect(readRegisteredLocalTarget(normalized.contents)).toEqual({
+      ...normalized.target,
+      reference: 'registered',
+      registered: true,
+    });
+  });
+
+  it.each([
+    'http://localhost:6443',
+    'https://example.com:6443',
+    'https://8.8.8.8:6443',
+    'https://localhost:443',
+    'https://user:password@localhost:6443',
+    'https://localhost:6443/path',
+    'https://localhost:6443?token=x',
+  ])('rejects a non-local or unexpected endpoint (%s)', server => {
+    const value = config();
+    value.clusters[0].cluster.server = server;
+    expect(() => normalizeLocalKubeconfig(yaml.stringify(value), configuration, 'lease')).toThrow(
+      'invalid-credentials'
+    );
+  });
+
+  it.each(['exec', 'auth-provider', 'token', 'client-key', 'client-certificate'])(
+    'rejects executable, external-file or alternate auth (%s)',
+    field => {
+      const value = config();
+      Object.assign(value.users[0].user, { [field]: 'not allowed' });
+      expect(() => normalizeLocalKubeconfig(yaml.stringify(value), configuration, 'lease')).toThrow(
+        'invalid-credentials'
+      );
+    }
+  );
+
+  it('rejects mismatched cluster names, malformed base64 and changed ownership metadata', () => {
+    const value = config();
+    expect(() =>
+      normalizeLocalKubeconfig(yaml.stringify(value), { ...configuration, name: 'other' }, 'lease')
+    ).toThrow('identity-mismatch');
+    value.users[0].user['client-key-data'] = 'not base64';
+    expect(() => normalizeLocalKubeconfig(yaml.stringify(value), configuration, 'lease')).toThrow(
+      'invalid-credentials'
+    );
+    const normalized = normalizeLocalKubeconfig(yaml.stringify(config()), configuration, 'lease');
+    expect(() =>
+      readRegisteredLocalTarget(normalized.contents.replace('aksedge-local', 'azure'))
+    ).toThrow('identity-mismatch');
+    expect(() =>
+      readRegisteredLocalTarget(
+        normalized.contents.replace(normalized.target.credentialFingerprint, 'a'.repeat(64))
+      )
+    ).toThrow('identity-mismatch');
+  });
+
+  it('rejects an existing context even if its connection settings appear identical', () => {
+    const normalized = normalizeLocalKubeconfig(yaml.stringify(config()), configuration, 'lease');
+    expect(() => assertNoLocalContextCollision('aksedge-demo', normalized.contents)).toThrow(
+      'collision'
+    );
+    expect(() =>
+      assertNoLocalContextCollision('another-context', normalized.contents)
+    ).not.toThrow();
+    expect(() => assertNoLocalContextCollision('aksedge-demo', '[ invalid: yaml')).toThrow(
+      'collision'
+    );
+  });
+
+  it('bounds file reads and refuses directories, empty files and multiply linked credentials', () => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'local-credentials-'));
+    const file = path.join(root, 'credentials.yaml');
+    try {
+      fs.writeFileSync(file, '');
+      expect(() => readPrivateKubeconfig(file)).toThrow('invalid-credentials');
+      expect(() => readPrivateKubeconfig(root)).toThrow('invalid-credentials');
+      fs.writeFileSync(file, yaml.stringify(config()));
+      expect(readPrivateKubeconfig(file)).toContain('current-context');
+      fs.linkSync(file, path.join(root, 'linked'));
+      expect(() => readPrivateKubeconfig(file)).toThrow('invalid-credentials');
+      fs.unlinkSync(path.join(root, 'linked'));
+      fs.writeFileSync(file, Buffer.alloc(1024 * 1024 + 1));
+      expect(() => readPrivateKubeconfig(file)).toThrow('invalid-credentials');
+    } finally {
+      fs.rmSync(root, { recursive: true, force: true });
+    }
+  });
+});
