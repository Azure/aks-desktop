index 0000000000000000000000000000000000000000..40ea36a25827737d2f931b9d724ca3c64ef09fb0
--- /dev/null
+++ b/source/frontend/src/components/App/useClusterPreOpen.ts
@@ -0,0 +1,150 @@
+/*
