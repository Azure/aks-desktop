+      expect(spawnMock).toHaveBeenCalledTimes(1);
+    });
+  });
+
+  it('fails replacement safely when the previous proxy cannot be signaled', async () => {
+    await withPlatform('linux', async () => {
+      const firstChild = proxyChild(1111);
