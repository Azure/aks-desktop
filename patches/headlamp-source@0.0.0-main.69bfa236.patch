+
+import { app } from 'electron';
+import path from 'node:path';
+import { applyProductMetadata, loadBuildManifest } from '../scripts/build-manifest';
+
+type RuntimeAppIdentity = Pick<Electron.App, 'getName' | 'getPath' | 'setName' | 'setPath'>;
+
+/** Applies the product manifest's display name to Electron before storage paths are resolved. */
+export function applyRuntimeProductIdentity(
+  runtimeApp: RuntimeAppIdentity,
+  manifest: unknown
+): string {
+  const { productName } = applyProductMetadata<{ productName?: string }>({}, manifest);
+  if (productName) {
+    const packageName = runtimeApp.getName();
+    const userDataPath = runtimeApp.getPath('userData');
+    runtimeApp.setName(productName);
+    if (path.basename(userDataPath) === packageName) {
+      runtimeApp.setPath('userData', path.join(path.dirname(userDataPath), productName));
+    }
+    return productName;
+  }
+  return runtimeApp.getName();
+}
+
+applyRuntimeProductIdentity(app, loadBuildManifest());
