+
+    rerender(
+      <MemoryRouter initialEntries={['/c/test-cluster/pods']}>
+        <TestContext routerMap={{ cluster: 'test-cluster' }}>
+          <PureAlertNotification checkerFunction={checker} suppress={false} />
+        </TestContext>
