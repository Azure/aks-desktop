diff --git a/source/frontend/src/components/App/useClusterPreOpen.ts b/source/frontend/src/components/App/useClusterPreOpen.ts
new file mode 100644
index 0000000000000000000000000000000000000000..671760c3d00d6092e376dd30096db7d5d08d2238
--- /dev/null
+++ b/source/frontend/src/components/App/useClusterPreOpen.ts
@@ -0,0 +1,150 @@
+/*
