+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+import { expect, test } from '@playwright/test';
+
+const batchMocks = [
+  {
+    url: 'http://localhost:4466/apis/batch/v1/jobs',
+    kind: 'JobList',
+  },
+  {
+    url: 'http://localhost:4466/apis/batch/v1/cronjobs',
+    kind: 'CronJobList',
+  },
+];
+
+test('Storybook serves batch workload fallbacks', async ({ page }) => {
+  test.setTimeout(60_000);
+  await page.goto('/iframe.html?id=common-actionbutton--basic&viewMode=story');
+
+  for (const mock of batchMocks) {
+    await expect
+      .poll(
+        () =>
+          page.evaluate(async url => {
+            try {
+              const response = await fetch(url);
+              return {
+                status: response.status,
+                body: await response.json(),
+              };
+            } catch {
+              return null;
+            }
+          }, mock.url),
+        { timeout: 30_000 }
+      )
+      .toEqual({
+        status: 200,
+        body: {
+          kind: mock.kind,
+          apiVersion: 'batch/v1',
+          metadata: {},
+          items: [],
+        },
+      });
+  }
+});
