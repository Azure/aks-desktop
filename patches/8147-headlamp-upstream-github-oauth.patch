+            pluginLocation: 'shipped',
+            plugins: [plugins[1]],
+            commands: [{ tool: 'gh', args: ['--version'] }],
+          },
+        ],
+      })
+    );
+    backend = createServer((_request, response) => {
+      response.writeHead(200, { 'Content-Type': 'application/json' }).end('{}');
+    });
