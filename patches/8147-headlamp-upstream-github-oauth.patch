+  const calls = openExternal.mock.calls.length;
+  const result = start(window);
+  await vi.waitFor(() => expect(openExternal.mock.calls.length).toBe(calls + 1));
+  const url = new URL(openExternal.mock.calls.at(-1)![0]);
