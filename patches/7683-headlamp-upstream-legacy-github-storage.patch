From 0b633519017a1fe6cbf7bc13e8b6dbdbb31d4b56 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ren=C3=A9=20Dudfield?= <renedudfield@microsoft.com>
Date: Tue, 22 Sep 2026 10:54:59 +0300
Subject: [PATCH 3/3] .github: app: Run secure storage migration E2E on macOS

The migration spec was listed in Playwright configuration but no required CI
command selected it. Linux may also skip it without an OS-backed encryption
service.

Install desktop E2E dependencies in the macOS app job and run the focused
migration, restart, namespace-denial, and sign-out scenario.
---
 .github/workflows/app.yml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/.github/workflows/app.yml b/.github/workflows/app.yml
index f6539d17358302b5da0aa5c85236452df69e92d6..669f703427ebe1d02ec7277aae4d810fb6c5a97d 100644
--- a/.github/workflows/app.yml
+++ b/.github/workflows/app.yml
@@ -165,5 +165,9 @@ jobs:
     - name: App Mac
       run: |
         make app-mac
+    - name: Install desktop e2e dependencies
+      run: npm --prefix app/e2e-tests ci
+    - name: Test plugin secure storage migration
+      run: npm run app:test:e2e -- tests/pluginSecureStorage.spec.ts --grep "migrates legacy GitHub"
     - name: Verify Mac build
       run: npm run app:verify-build-mac
