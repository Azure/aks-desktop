{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "build/*.ts"
      ],
      "project": [
        "build/**/*.ts"
      ],
      "ignoreDependencies": [
        "@headlamp-k8s/headlamp-source"
      ],
      "ignoreBinaries": [
        "lipo",
        "cosign"
      ]
    },
    "plugins/aks-desktop": {
      "entry": [
        "src/index.tsx",
        "src/**/*.stories.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.guidepup.test.{ts,tsx}",
        "src/utils/azure/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "src/**/*.d.ts"
      ],
      "ignoreDependencies": [
        "@azure/arm-resourcegraph",
        "@azure/arm-subscriptions",
        "@iconify/react",
        "@monaco-editor/react",
        "@mui/material",
        "@mui/utils",
        "@storybook/react",
        "@testing-library/jest-dom",
        "@types/libsodium-wrappers",
        "axe-core",
        "eslint-plugin-no-barrel-files",
        "i18next",
        "react-i18next",
        "react-router-dom"
      ],
      "ignoreBinaries": [
        "az",
        "prettier"
      ]
    },
    "plugins/aks-desktop-theme": {
      "entry": [
        "src/index.tsx",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@mui/material"
      ]
    },
    "plugins/plugin-catalog": {
      "entry": [
        "src/index.tsx",
        "src/**/*.stories.{ts,tsx}",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@iconify/react",
        "@mui/material",
        "lodash",
        "react-router",
        "react-router-dom"
      ]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "lint-staged": true,
  "husky": true,
  "tags": [
    "-lintignore"
  ]
}
